        log_info notice "It is advised to run ${BLUE}$0 ${YELLOW}sync${WHITE} before performing this operation."
        shift
        PACKAGES=( $(find $VEILERDBPATH/local -type d | sed '1d') )
        for PACKAGE in ${PACKAGES[@]}; do
            if [ -f $PACKAGE/info -a -f $PACKAGE/info ]; then 
                source $PACKAGE/info
                LOCALPKGVERSION=$MOONPKGVERSION
                source $PACKAGE/info
                SYNCPKGVERSION=$MOONPKGVERSION
                if [ $LOCALPKGVERSION != $SYNCPKGVERSION ]; then
                    UPGRADEDPACKAGES+=( "$PACKAGE" )
                    UPGRADEDPACKAGESLOCALVERSION+=( "$LOCALPKGVERSION" )
                    UPGRADEDPACKAGESSYNCVERSION+=( "$SYNCPKGVERSION" )
                fi
            else
                log_warn "No valid information file could be found for the package ${BLUE}$(echo $PACKAGE | sed 's/.*local\//')"
            fi
        done
        if [ ${#UPGRADEDPACKAGES[@]} -eq 0 ]; then
            log_err "Nothing to upgrade. Exiting"
