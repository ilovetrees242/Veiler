            for PACKAGE in ${PACKAGES[@]}; do
                if [ -s ""$VEILERDBPATH"/sync/"$PACKAGE"/testdependencies" ]; then
                    while read dependency; do
                        PACKAGES+=( "$dependency" )
                    done < ""$VEILERDBPATH"/sync/"$PACKAGE"/testdependencies"
                fi
            done
        fi
        for PACKAGE in ${PACKAGES[@]}; do
            push $PACKAGE
            while [ ${#STACK[@]} -gt 0 ]; do
                CURRENTPACKAGE=${STACK[$((${#STACK[@]} - 1))]}
                DEPS=()
                if [ -f "$VEILERDBPATH/sync/$CURRENTPACKAGE/dependencies" ]; then
                    while read dependency; do
                        DEPS+=( "$dependency" )
                    done < "$VEILERDBPATH/sync/$CURRENTPACKAGE/dependencies"
                fi
                if [ ${visited[$CURRENTPACKAGE]} ]; then pop && continue; fi
                for DEPENDENCY in ${DEPS[@]}; do
                    push $DEPENDENCY
                    if [ ${visited[$DEPENDENCY]} ]; then pop && continue; fi
                    if [ ! -d "$VEILERDBPATH/local/$DEPENDENCY" ]; then
                        break
                    fi
                    visited[$DEPENDENCY]="yes"
                    pop
                done
                if [[ ! -d "$VEILERDBPATH/local/$CURRENTPACKAGE" && $(checkifallvisited "$CURRENTPACKAGE") == "yes" && "${visited[$CURRENTPACKAGE]}" != "yes" ]]; then
                    RESOLVEDPACKAGES+=("$CURRENTPACKAGE")
                    visited[$CURRENTPACKAGE]="yes"
                fi
                if [[ $(checkifallvisited "$CURRENTPACKAGE") == "yes" && "${visited[$CURRENTPACKAGE]}" != "yes" ]]; then
                   RESOLVEDPACKAGES+=("$CURRENTPACKAGE")
                fi
                if [ "$(checkifallvisited "$CURRENTPACKAGE")" == "yes" ]; then
                    visited[$CURRENTPACKAGE]="yes"
                fi
            done
        done
        veiler_stop_animation
        PACKAGES=( ${RESOLVEDPACKAGES[@]} )
        makepkgarray "${PACKAGES[@]}"
    else
        makepkgarray "$@"
        return
    fi
    # --- End dependency calculating ---
}
makepkgarray(){
    PKGVERSION=()
    PKGNAME=()
    while [ $# -gt 0 ]; do
        if [ -f $VEILERDBPATH/sync/$1/info ]; then
            local BUFFERPKGVERSION="$(sed -n 's/^MOONPKGVERSION=//; s/"$//; s/^"//p' $VEILERDBPATH/sync/$1/info)"
            local BUFFERPKGNAME="$(sed -n 's/^MOONPKGNAME=//; s/"$//; s/^"//p' $VEILERDBPATH/sync/$1/info)"
        fi
        if [ -z "$BUFFERPKGVERSION" -a -z "$BUFFERPKGNAME" ]; then
            log_warn "No valid information related to ${YELLOW}$1${WHITE} could be found. Skipping this package..."
            shift
            continue
        elif [ -z "$BUFFERPKGVERSION" ]; then
            log_warn "No valid version could be found for ${YELLOW}$1${WHITE}. Skipping this package..." 
            shift
            continue
        elif [ -z "$BUFFERPKGNAME" ]; then
            log_warn "No valid name could be found for ${YELLOW}$1${WHITE}. Skipping this package..."
            shift
            continue
        fi
        PKGVERSION+=( "$BUFFERPKGVERSION" )
        PKGNAME+=( "$BUFFERPKGNAME" )
        BUFFERPKGVERSION=
        BUFFERPKGNAME=
        shift
    done
}
checkifallvisited(){
    if [ -f "$VEILERDBPATH/sync/$CURRENTPACKAGE/dependencies" ]; then
        while read dependency; do
            if [ ! ${visited[$dependency]} ]; then return; fi
        done < "$VEILERDBPATH/sync/$CURRENTPACKAGE/dependencies"
    fi
    echo "yes"
}
