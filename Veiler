#!/bin/bash

# Colors
DARKBLUE='\033[0;34m'
BLUE='\033[1;34m'
RED='\033[1;31m'
YELLOW='\033[1;33m'
ORANGE='\033[0;33m'
WHITE='\033[1;37m'
GRAY='\033[0;37m'
DARKGRAY='\033[1;30m'
NC='\033[0m'

log_warn(){
    echo -e "${ORANGE}WARNING >>>${WHITE} $1${NC}"
}
log_err(){
    if [ "$1" == "noexit" ];then 
        echo -e "${RED}ERROR >>>${WHITE} $2${NC}"
    else
        echo -e "${RED}ERROR >>>${WHITE} $1${NC}"
        exit 1
    fi
    shift
}
log_info(){
    case $1 in
        tip)
            echo -e "${BLUE}Tip >>>${WHITE} $2${NC}"
        ;;
        imp)
            echo -e "${YELLOW}Important >>>${WHITE} $2${NC}"    
        ;;
        notice)
            echo -e "${YELLOW}Notice >>>${WHITE} $2${NC}"    
        ;;
        activity)
            echo -e "${YELLOW}Activity >>>${WHITE} $2${NC}"    
        ;;
    esac
}
VEILERCUSTOMCONF=0
while [ $# -gt 0 ]; do
    case $1 in 
        --*)
            OPTIONS+=($1)
            case $1 in
                --with-dest)
                    if [ -n $2 ]; then
                        OPTIONS+=($2); shift
                    else
                        log_err "The option ${GRAY}--with-dest${WHITE} requires an argument!"
                    fi
                ;;
                --config)
                    if [ -z $2 ]; then
                        log_err "The option ${GRAY}--config${WHITE} requires a valid argument!"
                    elif [ $(echo $2 | cut -c1) != "/" ]; then
                        log_err "The option ${GRAY}--config${WHITE} requires an absolute path!"
                    elif [ ! -f $2 ]; then
                        log_err "Requested configuration file: ${YELLOW}$2${WHITE} does not exist on the system."
                    fi
                    OPTIONS+=($2); shift
                ;;
            esac
        ;;
        *)
            ARGUMENTS+=($1)
        ;;
    esac
    shift
done
for((i=0; i < ${#OPTIONS[@]}; i++)){
    if [ "${OPTIONS[$i]}" == "--config" -a -s $VEILERCONFIGPATH ]; then
        VEILERCONFIGPATH=${OPTIONS[$((i+1))]}
        VEILERCUSTOMCONF=1
        log_info notice "Using $VEILERCONFIGPATH as config"
    fi
}
# Main package manager related variables
declare -a OPTIONS PACKAGES
VEILERTESTS=0
VEILERQUIET=0
VEILERDOC=0
VEILERASK=0
VEILERONLYBUILD=0
VEILERNOROOT=0
VEILERSKIPDESC=0
VEILERSKIPDEPS=0
VEILERSKIPCLEAN=0
VEILERSKIPINST=0
VEILERSKIPINTEGRITY=0
VEILERERREXIT=0
VEILERMBE=0
VEILERDEST="/"
VEILERCACHEPATH="/var/cache/Veiler/"
VEILERDBPATH="/var/db/Veiler"
VEILERPREFIX="/usr"
PROCESSID=""
PKGREPO="https://ilovetrees242.github.io/Supplements/Website/Packages"
USEFLAGS=""
GLOBALUSEFLAGS=()
LOCALUSEFLAGS=()
STACK=()

if [ $VEILERCUSTOMCONF -eq 0 -a -s $VEILERCONFIGPATH ]; then 
    . /etc/Veiler/veiler.conf
elif [ $VEILERCUSTOMCONF -eq 1 ]; then 
    . $VEILERCONFIGPATH
fi

# Package handling related variables
declare -a PKGNAME PKGVERSION
declare -A visited
PACKAGES=()
RESOLVEPACKAGES=()
DEPS=()
PKGNAME=()
PKGVERSION=()

ADDITIONALDEPS=()
UPGRADEDPACKAGES=()
UPGRADEDPACKAGESLOCALVERSION=()
UPGRADEDPACKAGESSYNCVERSION=()
LOCALPKGVERSIONS=()
SYNCPKGVERSIONS=()

# Space and size related variables
TOTALDSR=0
TOTALINSTSIZE=0
TOTALUNINSTSIZE=0
TOTALDOWNLOADSIZE=0
TOTALUPGRADESIZE=0
TOTALUPGRADESIZEWODOC=0
WODOCINSTSIZE=0
SIZEBUFFER=0

# Extra variables

TRAPSET=0

if [ $(echo $VEILERDEST | cut -c1) != "/" ]; then
    log_err "DEST path must be an absolute path."
elif [ $(echo $VEILERCACHEPATH | cut -c1) != "/" ]; then
    log_err "Cache path must be absolute."
elif [ $(echo $VEILERDBPATH | cut -c1) != "/" ]; then
    log_err "DB path must be absolute."
fi

trap 'veiler_stop_animation' TERM 
trap 'echo -e "\n${YELLOW}Interrupted${NC}"; veiler_stop_animation; exit 1' INT

# --- Functions ---
play_animation(){
    while true; do
        printf "\r$1${WHITE}   ${NC}"; sleep 0.1
        printf "\r$1${WHITE}.  ${NC}"; sleep 0.1
        printf "\r$1${WHITE}.. ${NC}"; sleep 0.1
        printf "\r$1${WHITE}...${NC}"; sleep 0.1
    done &
    PROCESSID=$!
}
second_animation(){
    while true; do
        printf "\r$1${WHITE} [/]${NC}"; sleep 0.2
        printf "\r$1${WHITE} [-]${NC}"; sleep 0.2
        printf "\r$1${WHITE} [\\]${NC}"; sleep 0.2
        printf "\r$1${WHITE} [-]${NC}"; sleep 0.2
    done &
    PROCESSID=$!
}
veiler_stop_animation(){
    if [ -n "$PROCESSID" ]; then kill "$PROCESSID" &> /dev/null; echo; fi
}
clean(){
    if [ $VEILERSKIPCLEAN -eq 0 -a -d $VEILERCACHEPATH ]; then
        for directory in $(find $VEILERCACHEPATH -type d | sed '1d'); do
            rm -rf "${directory}" || log_err "Could not clean cache!"
        done        
    else
        return
    fi
}
checkifroot(){
    if [ $VEILERNOROOT -eq 0 -a $(id -u) -ne 0 ]; then
        log_err "You have to become root to perform this action."
    fi
}
checkIfAlreadyInstalled(){
    declare -a local newPackages
    newPackages=()
    for PACKAGE in $@; do
        if [ ! -d "$VEILERDBPATH/local/$PACKAGE" ]; then
            newPackages+=( $PACKAGE )
        fi
    done
    echo ${newPackages[@]}
}
getBuildTarballs(){
    log_info imp "Fetching package(s)..."
    for((i=0; i < ${#PKGNAME[@]}; i++)){
        if [ ! -f "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}".tar.gz" ]; then
            if [ $VEILERQUIET -eq 0 ]; then 
                wget -nv --show-progress "$PKGREPO"/build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}".tar.gz
            else 
                wget -q --show-progress "$PKGREPO"/build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}".tar.gz
            fi
            if [ $? -ne 0 ]; then 
                log_err noexit "Could not download the package ${YELLOW}${PKGNAME[$i]}${WHITE}!" && log_info tip "Maybe try running $0 ${GRAY}sync?${NC}"
                exit 1
            fi
        fi
        source $VEILERDBPATH/sync/${PKGNAME[$i]}/info
        unset MOONPKGNAME MOONPKGVERSION DESC INSTALLEDSIZE WODOCINSTALLEDSIZE REQDSKSPACE DOWNLOADSIZE 
        if [ -n "$MOONBASEPKG" ]; then
            source $VEILERDBPATH/sync/$MOONBASEPKG/info
            unset MOONPKG DESC INSTALLEDSIZE WODOCINSTALLEDSIZE REQDSKSPACE DOWNLOADSIZE 
            log_info notice "Downloading the base package >>> ${BLUE}$MOONBASEPKG${WHITE} for ${BLUE}${PKGNAME[$i]}"
            if [ ! -f "build-$MOONPKGNAME-$MOONPKGVERSION.tar.gz" ]; then
                wget -nv --show-progress "$PKGREPO/build-$MOONPKGNAME-$MOONPKGVERSION.tar.gz"
            fi
        fi
    }
}
extractBuildTarballs(){
    log_info imp "Extracting the package build tarball(s)..."
    for((i=0; i < ${#PKGNAME[@]}; i++)){
        echo -e "${GRAY}($((i+1))/${#PKGNAME[@]}) ${WHITE}Extracting ${YELLOW}>>> ${WHITE}${PKGNAME[$i]}${NC}"
        if [ $VEILERNOROOT -eq 0 ]; then
            su -c "if [ $VEILERQUIET -eq 1 ]; then tar xf "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}".tar.gz"; else tar xvf "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}".tar.gz"; fi" veiler-build-user
        else
            if [ $VEILERQUIET -eq 1 ]; then tar xf "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}".tar.gz"; else tar xvf "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}".tar.gz"; fi
        fi
        source $VEILERDBPATH/sync/${PKGNAME[$i]}/info
        unset MOONPKG DESC INSTALLEDSIZE WODOCINSTALLEDSIZE REQDSKSPACE DOWNLOADSIZE MOONPKGNAME MOONPKGVERSION 
        if [ -n "$MOONBASEPKG" ]; then
            source $VEILERDBPATH/sync/$MOONBASEPKG/info
            unset MOONPKG DESC INSTALLEDSIZE WODOCINSTALLEDSIZE REQDSKSPACE DOWNLOADSIZE
            if [ $VEILERNOROOT -eq 0 ]; then
                su -c "if [ $VEILERQUIET -eq 1 ]; then tar xf "build-"$MOONPKGNAME"-"$MOONPKGVERSION".tar.gz"; else tar xvf "build-"$MOONPKGNAME"-"$MOONPKGVERSION".tar.gz"; fi" veiler-build-user
            else
                if [ $VEILERQUIET -eq 1 ]; then tar xf "build-"$MOONPKGNAME"-"$MOONPKGVERSION".tar.gz"; else tar xvf "build-"$MOONPKGNAME"-"$MOONPKGVERSION".tar.gz"; fi
            fi
        fi
        if [ $? -ne 0 ]; then
            log_err "${GRAY}($((i+1))/${#PKGNAME[@]})${WHITE} Could not extract the build tarball for ${RED}>>> ${WHITE}${PKGNAME[$i]}"
        fi
    }
}
getSources(){
    log_info imp "Getting source(s) [ ${YELLOW}${#PKGNAME[@]}${WHITE} ]..."
    for((i=0; i < ${#PKGNAME[@]}; i++)){
        pushd "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}"" &> /dev/null
            source $VEILERDBPATH/sync/${PKGNAME[$i]}/info
            unset MOONPKGNAME MOONPKGVERSION DESC INSTALLEDSIZE WODOCINSTALLEDSIZE REQDSKSPACE DOWNLOADSIZE 
            if [ -n "$MOONBASEPKG" ]; then
                source $VEILERDBPATH/sync/$MOONBASEPKG/info
                if [ -z "$EXTENSION" ]; then
                    log_err noexit "${GRAY}($((i+1))/${#PKGNAME[@]})${WHITE} Valid extension could not be found for base package${RED} >>> ${WHITE}$MOONPKGNAME"
                    log_info tip "Extensions for the source tarball. Example: acl-2.3.2.tar.xz - extension = .tar.xz. More valid extensions for compressed files: .zip, .tar.zst, .tar.gz, .bzip2"
                    exit 1
                fi
                cd ../build-$MOONPKGNAME-$MOONPKGVERSION
            fi
            if [ -z "$EXTENSION" ]; then
                log_err noexit "${GRAY}($((i+1))/${#PKGNAME[@]})${WHITE} Valid extension could not be found for ${PKGNAME[$i]}"
                log_info tip "Extensions for the source tarball. Example: acl-2.3.2.tar.xz - extension = .tar.xz. More valid extensions for compressed files: .zip, .tar.zst, .tar.gz, .bzip2"
                exit 1
            fi
            if [ -n "$SRC" ]; then
                if [ ! -f "$MOONPKG$EXTENSION" ]; then
                    if [ $VEILERQUIET -eq 0 ]; then
                        wget -nv "$SRC" -O "$MOONPKG$EXTENSION"
                    else
                        wget -q --show-progress "$SRC" -O "$MOONPKG$EXTENSION"
                    fi
                fi
                if [ $? -ne 0 ]; then
                    log_err "${GRAY}($((i+1))/${#PKGNAME[@]})${WHITE} Failed to download the source for ${PKGNAME[$i]}"
                fi
            else
                if [ $VEILERERREXIT -eq 0 ]; then
                    log_err "${GRAY}($((i+1))/${#PKGNAME[@]})${WHITE} Valid source could not be found for ${PKGNAME[$i]}"
                fi
            fi      
            unset MOONBASEPKG
            if [ -s $VEILERDBPATH/sync/${PKGNAME[$i]}/additionaldownloads ]; then
                log_info imp "${GRAY}($((i+1))/${#PKGNAME[@]})${WHITE} Downloading additional files for the package ${BLUE}>>>${WHITE} ${PKGNAME[$i]} ${BLUE}<<< $(wc -l $VEILERDBPATH/sync/${PKGNAME[$i]}/additionaldownloads | sed 's/\s.*//')"
                while read filename; do
                    if [ ! -f "$(echo $filename | sed 's/.*\///')" ]; then
                       if [ $VEILERQUIET -eq 1 ]; then
                           wget -q --show-progress $filename
                       else
                           wget -nv --input-file $filename
                       fi
                    fi
                done < $VEILERDBPATH/sync/${PKGNAME[$i]}/additionaldownloads
            fi
       popd &> /dev/null
    }
}
getPatches(){
    log_info imp "Getting patch(es) [ ${YELLOW}${#PKGNAME[@]}${WHITE} ]..."
    for((i=0; i < ${#PKGNAME[@]}; i++)){
        pushd "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}"" &> /dev/null
            if [ -s "$VEILERDBPATH/sync/${PKGNAME[$i]}/patches" ]; then
                if [ $VEILERQUIET -eq 0 ]; then
                    wget -nv -nc --input-file "$VEILERDBPATH/sync/${PKGNAME[$i]}/patches"
                else
                    wget -nv -q --show-progress --input-file "$VEILERDBPATH/sync/${PKGNAME[$i]}/patches"
                fi
            fi
        popd &> /dev/null
    }
}
verifyChecksums(){
    for((i=0; i < ${#PKGNAME[@]}; i++)){
        if [ $VEILERSKIPINTEGRITY -eq 0 ]; then
            echo -ne "\r${YELLOW}Important >>> ${GRAY}("$((i+1))"/"${#PKGNAME[@]}") ${WHITE}Verifying package integrity ${DARKBLUE}|||${WHITE} ${PKGNAME[$i]}                                     ${NC}"
            source $VEILERDBPATH/sync/${PKGNAME[$i]}/info
            unset MOONPKGNAME MOONPKGVERSION MOONPKG SRC REQDSKSPC INSTALLEDSIZE WODOCINSTALLEDSIZE DOWNLOADSIZE 
            if [ -n "$MOONBASEPKG" ]; then
                source $VEILERDBPATH/sync/$MOONBASEPKG/info
                unset MOONPKG SRC REQDSKSPC INSTALLEDSIZE WODOCINSTALLEDSIZE DOWNLOADSIZE 
                pushd "build-"$MOONPKGNAME"-"$MOONPKGVERSION"" &> /dev/null
                    sha256sum -c --quiet integrity.sha256 || log_err "${GRAY}($((i+1))/${#PKGNAME[@]})${WHITE} Failed to verify package integrity for base package ${RED}>>>${WHITE} $MOONPKGNAME"
                popd &> /dev/null
                if [ $VEILERSKIPCLEAN -eq 0 ]; then
                    tar -cf "build-$MOONPKGNAME-$MOONPKGVERSION.tar.gz" "build-$MOONPKGNAME-$MOONPKGVERSION"  || log_err "${GRAY}($((i+1))/${#PKGNAME[@]})${WHITE}Failed to archive the base package ${RED}>>>${WHITE}$MOONPKGNAME" 
                fi
            fi  
            pushd "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}"" &> /dev/null
                sha256sum -c --quiet integrity.sha256 || log_err "${GRAY}($((i+1))/${#PKGNAME[@]})${WHITE} Failed to verify package integrity for package ${RED}>>>${WHITE} ${PKGNAME[$i]}"
            popd &> /dev/null
            sleep 0.1
        fi
        if [ $VEILERSKIPCLEAN -eq 0 ]; then
            tar -cf "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}".tar.gz" "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}"" || log_err "${GRAY}($((i+1))/${#PKGNAME[@]})${WHITE}Failed to archive the package" 
        fi
    }; echo
}
buildPackages(){
    export MAKEFLAGS="$MAKEFLAGS"
    export PKG_CONFIG_PATH="$PKGCONFPATH"
    USEFLAGS=( ${USEFLAGS[@]} )
    log_info imp "Building the package(s)..."
    GLOBALUSEFLAGS=( ${USEFLAGS[@]} )
    for((i=0; i < ${#PKGNAME[@]}; i++)){
        echo -e "${GRAY}($((i+1))/${#PKGNAME[@]})${WHITE} Building ${BLUE}>>> ${WHITE}${PKGNAME[$i]}${NC}"
        pushd "build-${PKGNAME[$i]}-${PKGVERSION[$i]}" &> /dev/null
            source $VEILERDBPATH/sync/${PKGNAME[$i]}/info
            unset MOONPKGNAME MOONPKGVERSION DESC SRC INSTALLEDSIZE WODOCINSTALLEDSIZE REQDSKSPACE DOWNLOADSIZE 
            if [ $VEILERERREXIT -eq 0 -a $TRAPSET -eq 0 ]; then trap 'log_err "${GRAY}($((i+1))/${#PKGNAME[@]})${WHITE} Failed to build the package ${RED}>>> ${WHITE}${PKGNAME[$i]}"' ERR; fi
            if [ -s /etc/Veiler/package.use ]; then
                while read pkg; do
                    if [ $(echo $pkg | sed 's/->.*//; s/^s//g') == "${PKGNAME[$i]}" ]; then
                        USEFLAGS=( "$(echo $pkg | sed "s/.*->//; s/^\s*//")" )
                        USEFLAGS=( $USEFLAGS )
                    fi
                done < /etc/Veiler/package.use
            fi
            if [ -n "$MOONBASEPKG" ]; then
                if [ ! -d $MOONPKG ]; then mkdir $MOONPKG; fi
                source $VEILERDBPATH/sync/$MOONBASEPKG/info
                cd ..
                tar xf "build-$MOONPKGNAME-$MOONPKGVERSION.tar.gz"
                cd "build-$MOONPKGNAME-$MOONPKGVERSION"
            fi
            if [ $VEILERSKIPCLEAN -eq 0 ]; then
                if [ -d "$MOONPKG" ]; then rm -rf "$MOONPKG"; fi
                if [ $VEILERQUIET -eq 1 ]; then
                    if [ $VEILERNOROOT -eq 0 ]; then
                         su -c "mkdir -p $MOONPKG && tar -xf "$MOONPKG".* -C $MOONPKG --strip-components=1" veiler-build-user
                    else
                        mkdir -p $MOONPKG && tar -xf "$MOONPKG".* -C $MOONPKG --strip-components=1
                    fi
                else
                    if [ $VEILERNOROOT -eq 0 ]; then
                        su -c "mkdir -p $MOONPKG && tar -xvf "$MOONPKG".* -C $MOONPKG --strip-components=1" veiler-build-user
                    else
                        mkdir -p $MOONPKG && tar -xvf "$MOONPKG".* -C $MOONPKG --strip-components=1
                    fi
                fi
            fi
            source $VEILERDBPATH/sync/${PKGNAME[$i]}/info
            unset DESC SRC INSTALLEDSIZE WODOCINSTALLEDSIZE REQDSKSPACE DOWNLOADSIZE 
            if [ -n "$MOONBASEPKG" ]; then
                cd ..
                cd "build-$MOONPKGNAME-$MOONPKGVERSION"
            fi
            pushd "$MOONPKG" &> /dev/null 
                if [ $VEILERNOROOT -eq 0 ]; then
                    if [ $VEILERQUIET -eq 1 ]; then
                        su -c "VEILERDEST=$VEILERDEST VEILERPREFIX=$VEILERPREFIX VEILERDBPATH=$VEILERDBPATH VEILERQUIET=$VEILERQUIET VEILERDOC=$VEILERDOC VEILERTESTS=$VEILERTESTS USEFLAGS=\"${USEFLAGS[*]}\" ../MOONBUILD build" veiler-build-user > /dev/null
                    else
                        su -c "VEILERDEST=$VEILERDEST VEILERPREFIX=$VEILERPREFIX VEILERDBPATH=$VEILERDBPATH VEILERQUIET=$VEILERQUIET VEILERDOC=$VEILERDOC VEILERTESTS=$VEILERTESTS USEFLAGS=\"${USEFLAGS[*]}\" ../MOONBUILD build" veiler-build-user
                    fi
                else
                    if [ $VEILERQUIET -eq 1 ]; then
                       VEILERDEST=$VEILERDEST VEILERPREFIX=$VEILERPREFIX USEFLAGS="$BUFFER" VEILERDBPATH=$VEILERDBPATH VEILERDOC=$VEILERDOC VEILERQUIET=$VEILERQUIET VEILERTESTS=$VEILERTESTS USEFLAGS="${USEFLAGS[*]}" ../MOONBUILD build > /dev/null
                    else
                        VEILERDEST=$VEILERDEST VEILERPREFIX=$VEILERPREFIX USEFLAGS="$BUFFER" VEILERDBPATH=$VEILERDBPATH VEILERDOC=$VEILERDOC VEILERQUIET=$VEILERQUIET VEILERTESTS=$VEILERTESTS USEFLAGS="${USEFLAGS[*]}" ../MOONBUILD build
                    fi
                fi
            popd &> /dev/null
            if [ $VEILERERREXIT -eq 0 -a $TRAPSET -eq 1 ]; then trap 'log_err "${GRAY}($((i+1))/${#PKGNAME[@]})${WHITE} Failed to install the package ${RED}>>> ${WHITE}${PKGNAME[$i]}"' ERR; TRAPSET=2; fi
            if [ $VEILERONLYBUILD -eq 0 ]; then 
                echo -e "${GRAY}($((i+1))/${#PKGNAME[@]})${WHITE} Installing ${YELLOW}>>> ${WHITE}${PKGNAME[$i]}${NC}"
                pushd "$MOONPKG" &> /dev/null
                    if [ $VEILERNOROOT -eq 0 ]; then
                        if [ $VEILERQUIET -eq 1 ]; then
                            VEILERPREFIX=$VEILERPREFIX VEILERDBPATH=$VEILERDBPATH VEILERQUIET=$VEILERQUIET ../MOONBUILD install > /dev/null
                        else
                            VEILERPREFIX=$VEILERPREFIX VEILERDBPATH=$VEILERDBPATH VEILERQUIET=$VEILERQUIET ../MOONBUILD install
                        fi
                    fi
                popd &> /dev/null
                if [ -f "$VEILERDBPATH/local/${PKGNAME[$i]}/files" ]; then
                    while read currentfile; do
                        rm -f "$VEILERDEST/$currentfile"
                    done < "$VEILERDBPATH/local/${PKGNAME[$i]}/files"
                fi
                cp -r "$VEILERDBPATH/sync/${PKGNAME[$i]}" "$VEILERDBPATH/local/"
                source $VEILERDBPATH/sync/${PKGNAME[$i]}/info
                unset MOONBASEPKG MOONPKGNAME MOONPKGVERSION DESC SRC INSTALLEDSIZE WODOCINSTALLEDSIZE REQDSKSPACE DOWNLOADSIZE 
                cd "$MOONPKG"/DEST
                if [ -s $VEILERDBPATH/sync/${PKGNAME[$i]}/docfiles ]; then
                    if [ $VEILERDOC -eq 0 ]; then
                        while read file; do
                            if [ $VEILERQUIET -eq 1 ]; then
                                rm -f "./$VEILERPREFIX$file"
                            else
                                rm -fv "./$VEILERPREFIX$file"
                            fi
                        done < $VEILERDBPATH/sync/${PKGNAME[$i]}/docfiles
                    fi
                fi
                find . ! -type d | sed 's/^.//' > $VEILERDBPATH/local/${PKGNAME[$i]}/files 
                if [ ! -d $VEILERDEST ]; then mkdir -p $VEILERDEST; fi
                if [ $VEILERQUIET -eq 1 ]; then
                    cp -fra ./* $VEILERDEST
                else
                    cp -frva ./* $VEILERDEST
                fi
            fi
        popd &> /dev/null
        echo -e "${GRAY}($((i+1))/${#PKGNAME[@]}) ${WHITE}Completed the build${DARKBLUE} >>> ${WHITE}${PKGNAME[$i]}${NC}"
    }
    unset MAKEFLAGS
    trap - ERR
}
uninstallPackages(){
    log_info imp "Uninstalling the package(s)"
    local UNINSTALLED=0
    for((i=0; i < ${#PKGNAME[@]}; i++)){
        echo -e "${GRAY}($((i+1))/${#PKGNAME[@]}) ${WHITE}Uninstalling ${BLUE}>>> ${WHITE}${PKGNAME[$i]}${NC}"
        if [ $VEILERERREXIT -eq 0 ]; then trap 'log_err "${GRAY}($((i+1)/${#PKGNAME[@]}))${WHITE} Failed to uninstall the package ${RED}>>>${WHITE} ${PKGNAME[$i]}"' ERR; fi
        if [ -f $VEILERDBPATH/local/${PKGNAME[$i]}/files ]; then
            while read file; do
                if [ $VEILERQUIET -eq 1 ]; then
                    rm -f "$file"
                else
                    rm -fv "$file"
                fi
            done < $VEILERDBPATH/local/${PKGNAME[$i]}/files
            UNINSTALLED=1
        fi
        rm -rf "$VEILERDBPATH/local/${PKGNAME[$i]}"
        echo -e "${GRAY}($((i+1))/${#PKGNAME[@]}) ${WHITE}Successfully uninstalled ${DARKBLUE}>>> ${WHITE}${PKGNAME[$i]}${NC}"
        if [ $UNINSTALLED -eq 1 ]; then
            log_info notice "Nothing was uninstalled."
        fi
    }
    trap - ERR
}
push(){
    STACK+=( "$1" )
}
pop(){
    unset 'STACK[$((${#STACK[@]} - 1))]'
}
resolvedeps(){
    # --- Start dependency calculating ---
    if [ $VEILERSKIPDEPS -eq 0 ]; then
        second_animation "$(log_info imp "Calculating dependencies")"
        PACKAGES=( "$@" )
        USEFLAGS=( $USEFLAGS )
        GLOBALUSEFLAGS=( ${USEFLAGS[@]} )
        for PACKAGE in ${PACKAGES[@]}; do
            if [ ${#GLOBALUSEFLAGS[@]} -gt 0 -o -s /etc/Veiler/package.use ]; then
                USEFLAGS=( ${GLOBALUSEFLAGS[@]} )
                while read pkg; do
                    if [ $(echo $pkg | sed 's/->.*//; s/\s//g') == "$PACKAGE" ]; then
                        BUFFER=( "$(echo $pkg | sed "s/.*->//; s/^\s*//")" )
                        USEFLAGS=( $BUFFER )
                    fi
                done < /etc/Veiler/package.use
                for FLAG in ${USEFLAGS[@]}; do
                     if [ -s "$VEILERDBPATH/sync/$PACKAGE/optdependencies" ]; then
                         while read pkg_line; do
                             if [ "$FLAG" == "$(echo $pkg_line | sed 's/ .*//')" ]; then
                                 PACKAGES+=( $(echo $pkg_line | sed 's/.* //' ) )
                             fi
                         done < "$VEILERDBPATH/sync/$PACKAGE/optdependencies"
                     fi
                 done
            fi
        done
