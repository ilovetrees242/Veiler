            echo -ne "${WHITE}Are you sure you would like to ${RED}delete${WHITE} them?[y/n]: ${NC}"
            read -n 1
            if [ "$REPLY" == "y" ]; then
                true; echo
            elif [ "$REPLY" == "n" ]; then
                echo; exit 0
            fi
        fi
        trap 'log_err "Could not delete one or more occurences"' ERR
        for((i=0; i < ${#PACKAGES[@]}; i++)){
            if [ $VEILERQUIET -eq 1 ]; then
                rm -rf ${PACKAGES[$i]}
            else
                rm -rfv ${PACKAGES[$i]}
            fi
        }
        log_info notice "Successfully deleted all the occurences for: $@"
    ;;
    clearcache)
        if [ -n "$VEILERCACHEPATH" -a -d "$VEILERCACHEPATH" ]; then
            rm -rvf "$VEILERCACHEPATH"/*.tar.*
        fi
        log_info imp "Always try to not run this operation as root user."
    ;;
	*)
        if [ -z $1 ]; then 
            log_err "No action specified!"
        else
            log_err "Invalid action ${RED}$1${WHITE} specified!"
        fi
        $0 help
	;;
esac
