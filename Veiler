            log_err "No package was provided!"
        fi
        PACKAGES=()
        for((i=1; i <= $#; i++)){
            PACKAGES[$((i-1))]=$(find $VEILERCACHEPATH -name "build-"${!i}"-*.*")
        }
        if [ ${#PACKAGES[@]} -eq 0 ]; then
            log_err "No occurences of the following packages could be found"
        fi
        log_info notice "The following occurences were found: "
        echo ${PACKAGES[@]}
