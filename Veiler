#!/bin/bash
# Main package manager related variables
PATH="$PATH:/etc/VeilerTools/usr/bin/"
PKGREPO="https://ilovetrees242.github.io/DevHelp/Website/Packages"
VEILERTESTS=0
VEILERQUIET=0
VEILERDOC=0
VEILERASK=0
VEILERSKIPDESC=0
VEILERDEST="/"
VEILERONLYBUILD=0
PROCESSID=""

# Colors
DARKBLUE='\033[0;34m'
BLUE='\033[1;34m'
YELLOW='\033[1;33m'
ORANGE='\033[0;33m'
WHITE='\033[1;37m'
GRAY='\033[0;37m'
DARKGRAY='\033[1;30m'
NC='\033[0m'

# Package handling related variables
PACKAGES=""
PACKAGEBUFFER=""
VICTIMPACKAGES=""
DEPSBUFFER=""
DEPS=""
VICTCNTR=0
DEPCNTR=0
DEPBUFCNTR=0

# Space and size related variables
TOTALDSR=0
TOTALINSTSIZE=0
TOTALDOWNLOADSIZE=0
WODOCINSTSIZE=0

trap 'veiler_stop_animation' TERM 
trap 'echo -e "\n${YELLOW}Interrupted${NC}"; veiler_stop_animation; exit 1' INT
source /etc/veiler.conf 

play_animation(){
    while true; do
        printf "\r$1${WHITE}   ${NC}"; sleep 0.1
        printf "\r$1${WHITE}.  ${NC}"; sleep 0.1
        printf "\r$1${WHITE}.. ${NC}"; sleep 0.1
        printf "\r$1${WHITE}...${NC}"; sleep 0.1
    done &
    PROCESSID=$!
}
second_animation(){
    while true; do
        printf "\r$1${WHITE} [/]${NC}"; sleep 0.2
        printf "\r$1${WHITE} [-]${NC}"; sleep 0.2
        printf "\r$1${WHITE} [\\]${NC}"; sleep 0.2
        printf "\r$1${WHITE} [-]${NC}"; sleep 0.2
    done &
    PROCESSID=$!
}
veiler_stop_animation(){
    if [ -n "$PROCESSID" ]; then kill "$PROCESSID" &> /dev/null; echo; fi
}
clean(){
    for directory in $(find /var/cache/Veiler/ -type d | sed '1d'); do
        rm -rfv "${directory}"
    done
}
for(( i=1; i <= $#; i++ )){
    case ${!i} in
        --quiet)
            if [ $VEILERQUIET -eq 0 ]; then
                set -- ${@:1:$((i-1))} ${@:$((i+1))}
                VEILERQUIET=1
                i=0
            elif [ $VEILERQUIET -eq 1 ]; then
                echo -e "${ORANGE}Error: ${WHITE}Quiet mode already enabled!${NC}"; exit 1
            fi
        ;;
        --documentation)
            if [ $VEILERDOC -eq 0 ]; then 
                set -- ${@:1:$((i-1))} ${@:$((i+1))}
                VEILERDOC=1
                i=0
            elif [ $VEILERDOC -eq 1 ]; then
                echo -e "${ORANGE}Error: ${WHITE}Documentation already enabled!${NC}"; exit 1
            fi
        ;;
        --tests)
            if [ $VEILERTESTS -eq 0 ]; then
                set -- ${@:1:$((i-1))} ${@:$((i+1))}
                VEILERTESTS=1
                i=0
            elif [ $VEILERTESTS -eq 1 ]; then
                echo -e "${ORANGE}Error: ${WHITE}Tests are already enabled!${NC}"; exit 1
            fi
        ;;
        --ask)
            if [ $VEILERASK -eq 0 ]; then
                set -- ${@:1:$((i-1))} ${@:$((i+1))}
                VEILERASK=1
                i=0
            elif [ $VEILERASK -eq 1 ]; then
                echo -e "${ORANGE}Error: ${WHITE}Confirmation prompts are already enabled!${NC}"; exit 1
            fi
        ;;
        --skip-description)
            if [ $VEILERSKIPDESC -eq 0 ]; then
                set -- ${@:1:$((i-1))} ${@:$((i+1))}
                VEILERSKIPDESC=1
                i=0
            elif [ $VEILERSKIPDESC -eq 1 ]; then
                echo -e "${ORANGE}Error: ${WHITE}Skipping description is already enabled"
            fi
        ;;
        --with-dest)
            ((i++))
            if [ -z ${!i} ]; then
                echo -e "${ORANGE}Error: ${GRAY}--with-dest${WHITE} option requires an argument.${NC}"
                exit 1
            fi
            VEILERDEST=${!i}
            set -- ${@:1:$((i-2))} ${@:$((i+1))}
            i=0
        ;;
        --build-only)
            if [ $VEILERONLYBUILD -eq 0 ]; then
                set -- ${@:1:$((i-1))} ${@:$((i+1))}
                VEILERONLYBUILD=1
                i=0
            elif [ $VEILERONLYBUILD -eq 1 ]; then
                echo -e "${ORANGE}Error: ${WHITE}Only building is already enabled!${NC}"
            fi  
        ;;
        *)
            OPTBUFFER=${!i}
            OPTBUFFER="$(echo $OPTBUFFER | grep "\--")"
            if [ -n "$OPTBUFFER" ]; then
                echo -e "${ORANGE}Error: Unknown option ${GRAY}$OPTBUFFER${NC}"
                exit 1
            fi
        ;;
    esac
}
case $1 in
	unveil)
        shift
        if [ -z "$1" ]; then
            echo -e "${ORANGE}Error: ${WHITE}No package provided!${NC}"
            exit 1
        elif [ $(id -u) -ne 0 ]; then
            echo -e "${ORANGE}Error: ${WHITE}You need to be root in order to perform this action.${NC}"
            exit 1
        fi
        play_animation "${YELLOW}Activity: ${WHITE}Checking if packages exist${NC}"
        sleep 0.1
        for PACKAGE in "$@"; do
            if [ ! -d "/var/db/Veiler/sync/$PACKAGE" ]; then echo -e "${ORANGE}\nError: ${WHITE}The requested package ${YELLOW}$PACKAGE${WHITE} could not be found on the database.${NC}"; veiler_stop_animation; exit 1; fi
        done
        veiler_stop_animation
        second_animation "${YELLOW}Important: ${WHITE}Calculating dependencies${NC}"
        PKGCOUNT=0 
        for PACKAGE in "$@"; do
            PACKAGES[$PKGCOUNT]=$PACKAGE
            ((PKGCOUNT++))
        done
        for((i=0; i < ${#PACKAGES[@]}; i++)){
            PACKAGEBUFFER[$i]=${PACKAGES[$i]}
        } 
        # PACKAGES contains the packages which actually need to installed
        # PACKAGEBUFFER contains the packages whos depdencies are being checked
        # DEPS contains the all the found dependencies of all packages generated by the graph
        # DEPSBUFFER contains the packages whos dependencies will be checked after the next iteration
        # VICTIMPACKAGES holds a single copy of every package
        
        # Example -> which neofetch, missing deps: bash, ncurses, readline
        # Contents of PACKAGEBUFFER->
        # Stage 1 : which neofetch
        # stage 2 : bash bash
        # Stage 3 : ncurses readline ncurses readline
        # Stage 4 : 
        while [ ! -z "$PACKAGEBUFFER" ]; do
            for PACKAGE in ${PACKAGEBUFFER[@]}; do 
                while read DEPENDENCY; do
                    if [ ! -d "/var/db/Veiler/local/$DEPENDENCY" ]; then 
                        DEPS[$DEPCNTR]=$DEPENDENCY
                        DEPSBUFFER[$DEPBUFCNTR]=$DEPENDENCY
                        ((DEPCNTR++))
                        ((DEPBUFCNTR++))
                    fi
                done < "/var/db/Veiler/sync/$PACKAGE/dependencies"
            done
            PACKAGEBUFFER=()
            for((i=0; i < ${#DEPSBUFFER[@]}; i++)){
                PACKAGEBUFFER[$i]=${DEPSBUFFER[$i]}
            }
            DEPSBUFFER=()
            DEPBUFCNTR=0
        done
        checkifexists(){
            for((i=0; i < ${#VICTIMPACKAGES[@]}; i++)){
                if [ "${VICTIMPACKAGES[$i]}" == "$1" ]; then
                    echo "yes"; return 0;
                fi
            }
            echo "no"
        }
        for((i=0; i < ${#PACKAGES[@]}; i++)){
            PACKAGEBUFFER[$i]=${PACKAGES[$i]}
        }
        for((i=0; i < ${#DEPS[@]}; i++)){
            PACKAGEBUFFER[${#PACKAGEBUFFER[@]}]=${DEPS[$i]}
        }
        for((i=0; i < ${#PACKAGEBUFFER[@]}; i++)){
            EXISTS=$(checkifexists ${PACKAGEBUFFER[$i]})
            if [ $EXISTS == "no" ]; then
                VICTIMPACKAGES[$VICTCNTR]=${PACKAGEBUFFER[$i]}
                ((VICTCNTR++))
            fi
        }
        BUFFER=${PACKAGEBUFFER[@]}
        for PACKAGE in ${VICTIMPACKAGES[@]}; do
            OCCURENCES=$(echo ${PACKAGEBUFFER[@]} | grep -ow "$PACKAGE" | wc -w)
            ((OCCURENCES--))
            for((i=0; i < $OCCURENCES; i++)){
                BUFFER=$(echo $BUFFER | sed "s@$PACKAGE@@1")
            }
        done
        # Reverse the packages to build in correct order
        PACKAGES=( $BUFFER )
        PACKAGES=( $(printf "%s\n" ${PACKAGES[@]} | tac) )
        set -- ${PACKAGES[@]}
        veiler_stop_animation
        for((i=1; i <= $#; i++)){
            PKGVERSION[$((i-1))]="$(sed -n 's/^MOONPKGVERSION=//; s/"$//; s/^"//p' /var/db/Veiler/sync/"${!i}"/info)"
            PKGNAME[$((i-1))]="$(sed -n 's/^MOONPKGNAME=//; s/"$//; s/^"//p' /var/db/Veiler/sync/"${!i}"/info)"
            ((COUNT++))
        }
        echo -ne "\n${YELLOW}Packages to be installed: ${NC}"
        for((i=0; i < $#; i++)){
            if [ -d /var/db/Veiler/local/"${PKGNAME[$i]}" ]; then
                LOCALPKGVERSION="$(sed -n 's/^MOONPKGVERSION=//; s/"$//; s/^"//p' /var/db/Veiler/local/"${PKGNAME[$i]}"/info)"
                if [ "${PKGVERSION[$i]}" != "$LOCALPKGVERSION" ]; then
                    echo -ne "${WHITE}"${PKGNAME[$i]}" ${GRAY}("$LOCALPKGVERSION")${WHITE} -> "${PKGNAME[$i]}" ${GRAY}("${PKGVERSION[$i]}")${NC}   "
                else
                    echo -ne "${WHITE}"${PKGNAME[$i]}" ${GRAY}("$LOCALPKGVERSION")${NC}  "
                fi
            else
                echo -ne "${WHITE}"${PKGNAME[$i]}" ${GRAY}("${PKGVERSION[$i]}")${NC}  "
            fi
        }
        echo; echo
        for PACKAGE in $@; do
            SPACEBUFFER=$(sed -n 's/^REQDSKSPC=//p' /var/db/Veiler/sync/$PACKAGE/info)
            SPACEBUFFER="$(echo $SPACEBUFFER | sed 's/"//g')"
            ((TOTALDSR+=SPACEBUFFER))
        done
        ((TOTALDSR/=1024))
        echo -e "${DARKBLUE}*** ${BLUE}Total disk space required: ${WHITE}"$TOTALDSR"KiB${NC}"
        for PACKAGE in $@; do
            SPACEBUFFER=$(sed -n 's/^DOWNLOADSIZE=//p' /var/db/Veiler/sync/$PACKAGE/info)
            SPACEBUFFER="$(echo $SPACEBUFFER | sed 's/"//g')"
            ((TOTALDOWNLOADSIZE+=SPACEBUFFER))
        done
        ((TOTALDOWNLOADSIZE/=1024))
        echo -e "${DARKBLUE}*** ${BLUE}Total download size: ${WHITE}"$TOTALDOWNLOADSIZE"KiB${NC}"
        for PACKAGE in $@; do
            SPACEBUFFER=$(sed -n 's/^INSTALLEDSIZE=//p' /var/db/Veiler/sync/$PACKAGE/info)
            SPACEBUFFER="$(echo $SPACEBUFFER | sed 's/"//g')"
            ((TOTALINSTSIZE+=SPACEBUFFER))
        done
        ((TOTALINSTSIZE/=1024))
        echo -e "${DARKBLUE}*** ${BLUE}Total installed size: ${WHITE}"$TOTALINSTSIZE"KiB${NC}"
        for PACKAGE in $@; do
            SPACEBUFFER=$(sed -n 's/^WODOCINSTALLEDSIZE=//p' /var/db/Veiler/sync/$PACKAGE/info)
            SPACEBUFFER="$(echo $SPACEBUFFER | sed 's/"//g')"
            ((WODOCINSTSIZE+=SPACEBUFFER))
        done
        ((WODOCINSTSIZE/=1024))
        echo -e "${DARKBLUE}*** ${BLUE}Total installed size ( without documentation ): ${WHITE}"$WODOCINSTSIZE"KiB${NC}"
        if [ "$VEILERASK" -eq 1 ]; then
            echo -ne "${YELLOW}||| ${WHITE}Proceed with the installation?[y/n]: "
            read -n 1
            if [ "$REPLY" == "y" ]; then
                echo; true
            else
                echo -e "\n${WHITE}Goodbye!${NC}"; exit 0
            fi
        else
            echo -e "\n"
        fi
        if [ $VEILERQUIET -eq 0 ]; then
            echo -e "${YELLOW}Notice: ${WHITE}Changing directory to /var/cache/Veiler...${NC}"
            pushd /var/cache/Veiler &> /dev/null && clean
            echo -e "${YELLOW}Important: ${WHITE}Fetching package(s)...${NC}"
            for((i=0; i < $#; i++)){
                if [ ! -f "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}".tar.gz" ]; then
                    wget "$PKGREPO/build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}".tar.gz"
                    if [ $? -ne 0 ]; then
                        echo -e "${ORANGE}Error: ${WHITE}Could not download the package ${YELLOW}${PKGNAME[$i]}${WHITE}!${NC}"
                        echo -e "${YELLOW}Tip: ${WHITE}Maybe try running $0 ${GRAY}sync?${NC}"
                        exit 1
                    fi
                fi
            }
            echo -e "${YELLOW}Important: ${WHITE}Extracting the package build tarballs...${NC}"
            for((i=0; i < $#; i++)){
                echo -e "${GRAY}($((i+1))/$#) ${YELLOW}Extracting ${BLUE}>>> ${WHITE}${PKGNAME[$i]}"
                tar xf "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}".tar.gz"
                if [ $? -ne 0 ]; then
                    echo -e "${ORANGE}Error: ${WHITE}Could not extract the build tarball for ${YELLOW}${PKGNAME[$i]} ${GRAY}($((i+1))/$#) ${NC}"; exit 1
                fi
            }
            echo -e "${YELLOW}Important: ${WHITE}Downloading sources...${NC}"
            for((i=0; i < $#; i++)){
                pushd "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}"" &> /dev/null
                    source ./MOONBUILD getpkg
                    if [ $? -ne 0 ]; then
                        echo -e "${ORANGE}Error: ${WHITE}Failed to download the source for ${PKGNAME[$i]} ${GRAY}($((i+1))/$#)${NC}"; exit 1
                    fi
                popd &> /dev/null
            }
            for((i=0; i < $#; i++)){
                echo -ne "\r${WHITE}(${GRAY}"$((i+1))"/"$#"${WHITE}) ${YELLOW}Important: ${WHITE}Verifying package integrity ${DARKBLUE}|||${WHITE} ${PKGNAME[$i]}                                     "
                pushd "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}"" &> /dev/null
                    source ./MOONBUILD verifyintegrity
                    if [ $? -ne 0 ]; then
                        echo -e "${ORANGE}Error: ${WHITE}Failed to verify package integrity for package: ${PKGNAME[$i]} ${GRAY}($((i+1))/$#)${NC}"
                        exit 1
                    fi
                popd &> /dev/null
                tar -cf "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}".tar.gz" "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}"" 
            }; echo
            for((i=0; i < $#; i++)){
                Package="build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}""
                pushd "$Package" &> /dev/null
                    echo -e "${GRAY}($((i+1))/$#) ${YELLOW}Building ${ORANGE}>>> ${WHITE}${PKGNAME[$i]}${NC}"
                    source ./MOONBUILD build
                    if [ $? -ne 0 ]; then
                        echo -e "${ORANGE}Error: ${WHITE}Failed to build ${ORANGE}>>> ${WHITE}${PKGNAME[$i]}${NC}"; exit 1
                    fi
                    if [ $VEILERONLYBUILD -eq 0 ]; then
                        echo -e "${GRAY}($((i+1))/$#) ${YELLOW}Installing ${GRAY}>>> ${WHITE}${PKGNAME[$i]}${NC}"
                        DESTDIR=$VEILERDEST source ./MOONBUILD install
                        if [ $? -ne 0 ]; then
                            echo -e "${ORANGE}Error: ${WHITE}Failed to install ${GRAY}>>> ${WHITE}${PKGNAME[$i]}${NC}"; exit 1
                        fi
                    fi
                popd &> /dev/null
                echo -e "${GRAY}($((i+1))/$#) ${YELLOW}Completed build${WHITE} >>> ${PKGNAME[$i]}${NC}"
                rm -rf $Package
            }
            if [ $VEILERONLYBUILD -eq 1 ]; then
                echo -e "${YELLOW}Notice: ${WHITE}The package manager has finished building all the packages but has not installed them. Goodluck with whatever you are trying to do!${NC}"
                echo -e "${YELLOW}Important: ${WHITE}The build directories can be found at /var/cache/Veiler/${NC}"
            fi
            popd &> /dev/null
        else
            echo -e "${YELLOW}Notice: ${WHITE}Changing directory to /var/cache/Veiler...${NC}"
            pushd /var/cache/Veiler &> /dev/null && clean &> /dev/null
            echo -e "${YELLOW}Important: ${WHITE}Fetching package(s)...${NC}"
            for((i=0; i < $#; i++)){
                if [ ! -f "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}".tar.gz" ]; then
                    wget -q --show-progress "$PKGREPO/build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}".tar.gz"
                    if [ $? -ne 0 ]; then
                        echo -e "${ORANGE}Error: ${WHITE}Could not download the package ${YELLOW}${PKGNAME[$i]}${WHITE}!${NC}"
                        echo -e "${YELLOW}Tip: ${WHITE}Maybe try running $0 ${GRAY}sync?${NC}"
                        exit 1
                    fi
                fi
            }
            echo -e "${YELLOW}Important: ${WHITE}Extracting the package build tarballs...${NC}"
            for((i=0; i < $#; i++)){
                echo -e "${GRAY}($((i+1))/$#) ${YELLOW}Extracting ${BLUE}>>> ${WHITE}${PKGNAME[$i]}"
                tar xf "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}".tar.gz"
                if [ $? -ne 0 ]; then
                    echo -e "${ORANGE}Error: ${WHITE}Could not extract the build tarball for ${YELLOW}${PKGNAME[$i]} ${GRAY}($((i+1))/$#)${NC}"; exit 1
                fi
            }
            echo -e "${YELLOW}Important: ${WHITE}Downloading sources...${NC}"
            for((i=0; i < $#; i++)){
                pushd "build-${PKGNAME[$i]}-${PKGVERSION[$i]}" &> /dev/null 
                    source ./MOONBUILD getpkg
                    if [ $? -ne 0 ]; then
                        echo -e "${ORANGE}Error: ${WHITE}Failed to download the source for ${PKGNAME[$i]} ${GRAY}($((i+1))/$#)${NC}"; exit 1
                    fi
                popd &> /dev/null
            }
            for((i=0; i < $#; i++)){
                echo -ne "\r${WHITE}(${GRAY}"$((i+1))"/"$#"${WHITE}) ${YELLOW}Important: ${WHITE}Verifying package integrity ${DARKBLUE}|||${WHITE} ${PKGNAME[$i]}                 "
                pushd "build-${PKGNAME[$i]}-${PKGVERSION[$i]}" &> /dev/null 
                    source ./MOONBUILD verifyintegrity
                    if [ $? -ne 0 ]; then
                        echo -e "${ORANGE}Error: ${WHITE}Failed to verify package integrity for package for ${PKGNAME[$i]} ${GRAY}($((i+1))/$#)${NC}"
                        exit 1
                    fi
                popd &> /dev/null
                tar -cf "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}".tar.gz" "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}"" 
            }; echo
            for((i=0; i < $#; i++)){
                Package="build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}""
                pushd "$Package" &> /dev/null
                    echo -e "${GRAY}($((i+1))/$#) ${YELLOW}Building${WHITE} ${ORANGE}>>> ${WHITE}${PKGNAME[$i]}${NC}"
                    source ./MOONBUILD build
                    if [ $? -ne 0 ]; then
                        echo -e "${ORANGE}Error: ${WHITE}Failed to build ${ORANGE}>>> ${WHITE}${PKGNAME[$i]}${NC}"; exit 1
                    fi
                    if [ $VEILERONLYBUILD -eq 0 ]; then
                        echo -e "${GRAY}($((i+1))/$#) ${YELLOW}Installing ${GRAY}>>> ${WHITE}${PKGNAME[$i]}${NC}"
                        DESTDIR=$VEILERDEST source ./MOONBUILD install
                        if [ $? -ne 0 ]; then
                            echo -e "${ORANGE}Error: ${WHITE}Failed to configure ${GRAY}>>> ${WHITE}${PKGNAME[$i]}${NC}"; exit 1
                        fi
                    fi
                popd &> /dev/null
                echo -e "${GRAY}($((i+1))/$#) ${YELLOW}Completed the build${WHITE} >>> ${PKGNAME[$i]}${NC}"
            }
            popd &> /dev/null
            if [ $VEILERONLYBUILD -eq 1 ]; then
                echo -e "${YELLOW}Notice: ${WHITE}The package manager has finished building the packages, but has not installed them. Goodluck with whatever you are doing!${NC}"
                echo -e "${YELLOW}Important: ${WHITE}The build directories can be found at /var/cache/Veiler/${NC}"
            fi
        fi
    ;;
	veil)
        shift
        if [ -z "$1" ]; then
            echo -e "${ORANGE}Error: ${WHITE}No package was provided!${NC}"
            exit 1
        fi
        play_animation "${YELLOW}Activity: ${WHITE}Checking if packages exist${NC}"
        for PACKAGE in "$@"; do
            if [ ! -d "/var/db/Veiler/sync/$PACKAGE" ]; then echo -e "${ORANGE}\nError: ${WHITE}The requested package ${YELLOW}$PACKAGE${WHITE} could not be found on the database.${NC}"; veiler_stop_animation; exit 1; fi
        done
        sleep 0.1
        veiler_stop_animation
        for((i=1; i <= $#; i++)){
            PKGVERSION[$((i-1))]="$(sed -n 's/^MOONPKGVERSION=//; s/"$//; s/^"//p' /var/db/Veiler/sync/"${!i}"/info)"
            PKGNAME[$((i-1))]="$(sed -n 's/^MOONPKGNAME=//; s/"$//; s/^"//p' /var/db/Veiler/sync/"${!i}"/info)"
            ((COUNT++))
        }
        echo -ne "\n${YELLOW}Packages to be uninstalled: ${WHITE}"
        for((i=0; i <= ${PKGNAME[@]}; i++)){
            echo -ne "${WHITE}${PKGNAME[$i]} ${GRAY}(${PKGVERSION[$i]})${NC}   "
        }
        if [ $VEILERASK -eq 1 ]; then
            echo -ne "\n\n${BLUE}||| ${WHITE}Proceed with the uninstallation?[y/n]: ${NC}"
            read -n 1
            if [ $REPLY == "y" ]; then
                true; echo
            else
                echo -e "\n${WHITE}Goodbye!${NC}"; exit 0
            fi
        else 
            echo -e "\n"
        fi
        if [ "$VEILERQUIET" -eq 1 ]; then
            echo -e "${YELLOW}Notice: ${WHITE}Changing directory to /var/cache/Veiler...${NC}"
            pushd /var/cache/Veiler &> /dev/null && clean &> /dev/null
            echo -e "${YELLOW}Important: ${WHITE}Fetching package(s)...${NC}"
            for((i=0; i < $#; i++)){
                if [ ! -f "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}".tar.gz" ]; then
                    wget -q --show-progress "$PKGREPO/build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}".tar.gz"
                    if [ $? -ne 0 ]; then
                        echo -e "${ORANGE}Error: ${WHITE}Could not download the package ${YELLOW}${PKGNAME[$i]}${WHITE}!${NC}"
                        echo -e "${YELLOW}Tip: ${WHITE}Maybe try running $0 ${GRAY}sync?${NC}"
                        exit 1
                    fi
                fi
            }
            echo -e "${YELLOW}Important: ${WHITE}Extracting the build tarballs${NC}"
            for((i=0; i < $#; i++)){
            echo -e "${GRAY}($((i+1))/$#) ${YELLOW}Extracting ${BLUE}>>> ${WHITE}${PKGNAME[$i]}${NC}"
                tar xf "build-${PKGNAME[$i]}-${PKGVERSION[$i]}.tar.gz"
                if [ $? -ne 0 ]; then
                    echo -e "${ORANGE}Error: ${WHITE}Could not extract the build tarball for ${PKGNAME[$i]} ${GRAY} ($((i+1))/$#)${NC}"; exit 1
                fi
            }
            for((i=0; i < $#; i++)){
                echo -e "${GRAY}($((i+1))/$#) ${YELLOW}Uninstalling ${DARKBLUE}>>> ${WHITE}${PKGNAME[$i]}${NC}"
                pushd "build-${PKGNAME[$i]}-${PKGVERSION[$i]}" &> /dev/null
                    source ./MOONBUILD uninstall
                    if [ $? -ne 0 ]; then
                        echo -e "${ORANGE}Error: ${WHITE}Failed to uninstall ${PKGNAME[$i]} ${GRAY}($((i+1))/$#)${NC}"
                        exit 1
                    fi
                popd &> /dev/null
                echo -e "${GRAY}($((i+1))/$#) ${YELLOW}Successfully uninstalled ${BLUE}>>> ${WHITE}${PKGNAME[$i]}${NC}"
            }
            popd &> /dev/null
        else    
            echo -e "${YELLOW}Notice: ${WHITE}Changing directory to /var/cache/Veiler...${NC}"
            pushd /var/cache/Veiler &> /dev/null && clean &> /dev/null
            echo -e "${YELLOW}Important: ${WHITE}Fetching package(s)...${NC}"
            for((i=0; i < $#; i++)){
                if [ ! -f "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}".tar.gz" ]; then
                    wget "$PKGREPO/build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}".tar.gz"
                    if [ $? -ne 0 ]; then
                        echo -e "${ORANGE}Error: ${WHITE}Could not download the package ${YELLOW}${PKGNAME[$i]}${WHITE}!${NC}"
                        echo -e "${YELLOW}Tip: ${WHITE}Maybe try running $0 ${GRAY}sync?${NC}"
                        exit 1
                    fi
                fi
            }
            echo -e "${YELLOW}Important: ${WHITE}Extracting the build tarballs...${NC}"
            for((i=0; i < $#; i++)){
                echo -e "${GRAY}($((i+1))/$#) ${YELLOW}Extracting ${BLUE}>>> ${WHITE}${PKGNAME[$i]}${NC}"
                tar xf "build-${PKGNAME[$i]}-${PKGVERSION[$i]}.tar.gz"
                if [ $? -ne 0 ]; then
                    echo -e "${ORANGE}Error: ${WHITE}Could not extract the build tarball for ${PKGNAME[$i]}${NC}"; exit 1
                fi
            }
            for((i=0; i < $#; i++)){
                echo -e "${GRAY}($((i+1))/$#) ${YELLOW}Uninstalling ${DARKBLUE}>>> ${WHITE}${PKGNAME[$i]}${NC}"
                pushd "build-${PKGNAME[$i]}-${PKGVERSION[$i]}" &> /dev/null
                    source ./MOONBUILD uninstall
                    if [ $? -ne 0 ]; then
                        echo -e "${ORANGE}Error: ${WHITE}Failed to uninstall ${PKGNAME[$i]} ${GRAY}($((i+1))/$#)${NC}"
                        exit 1
                    fi
                popd &> /dev/null
                echo -e "${GRAY}($((i+1))/$#) ${YELLOW}Successfully uninstalled ${BLUE}>>> ${WHITE}${PKGNAME[$i]}${NC}"
            }
            popd &> /dev/null
        fi
	;;
	strengthen)
        # TO DO: Later, add a feature to update packages installed on system if new version has been released and is greater than installed version
	;;
    info)
        shift
        if [ -z $1 ]; then
            echo -e "${YELLOW}No package provided.${NC}"
            exit 1
        fi
        for((i=1; i <= $#; i++)){
            if [ ! -d "/var/db/Veiler/local/${!i}" ]; then
                echo -e "${YELLOW}Warning: ${WHITE}${!i} is not installed.${NC}"
                set -- $(echo "$@" | sed "s@${!i}@@")
                i=1
            fi
        }
        for((i=1; i <= $#; i++)){
            source "/var/db/Veiler/local/${!i}/info" 2&> /dev/null
            echo -e "${YELLOW}$MOONPKGNAME${NC} ${GRAY}($MOONPKGVERSION)${NC}"
            echo -e "\t${WHITE}$DESC${NC}"
        }
    ;;
	help)
        echo -e "${YELLOW}$0 Usage:${WHITE} $0 <COMMAND> <OPTIONS> ${NC}"
		echo -e "${WHITE}$0 unveil|veil <OPTIONS> [PACKAGE]${NC}"
		echo -e "${WHITE}$0 Options:${NC}" 
	    echo -e "${GRAY}--verbose${NC}${WHITE}       : Displays verbose output${NC}"
        echo -e "${GRAY}--quiet${NC}${WHITE}         : Displays quiet output, not too detailed.${NC}"
	    echo -e "${GRAY}--documentation${NC}${WHITE} : Enables documentation (this might install extra dependencies)${NC}"
        echo -e "${GRAY}--test${NC}${WHITE}          : Enables test harnesses${NC}" 
        echo -e "${GRAY}--ask${NC}${WHITE}           : Use confirmation prompts{NC}"
		echo -e "${WHITE}unveil     : Installs a package from source.${NC}"
        echo -e "${WHITE}   -> ${GRAY}--with-dest <DESTDIR> ${WHITE}: Installs package into <DESTDIR> instead of default /"
        echo -e "${WHITE}   -> ${GRAY}--build-only          ${WHITE}: This option makes the package manager only compile and build the package and skip installing it.${NC}
		echo -e "${WHITE}veil       : Uninstalls a package installed on the system${NC}"
		echo -e "${WHITE}strengthen : Updates all packages installed on the system${NC}"
		echo -e "${WHITE}search     : Matches regex with a package name in the package database${NC}"
        echo -e "${WHITE}   -> ${GRAY}--skip-description: ${WHITE}To avoid matching the regex with found descriptions${NC}"
		echo -e "${WHITE}help       : Displays this output${NC}"
        echo -e "${WHITE}version    : Display package manager version${NC}"
        echo -e "${WHITE}info       : Display information about installed packages${NC}"
        echo -e "${WHITE}rmpkg      : Removes ALL the tarballs of the specified package in the cache ( useful for reducing disk space usage and making the package manager download the package build tarball again, which may be done if the maintainer has applied some patches to the build script )${NC}"
        echo -e "${YELLOW}Note: ${WHITE}See https://ilovetrees242.github.io/DevHelp/Website/Veiler.html for detailed information${NC}"
	;;
    version)
            echo -e "${WHITE}I like the ${YELLOW}moon${WHITE}, so this package manager is based of it."
            echo "__    __  _____   o  ___    _____   _____  "
            echo "\ \  / / |     | | | | |   |     |  | ___\ " 
            echo " \ \/ /  | ----| | | | |_  | ----|  | |    "
            echo "  \__/   |_____  |_| |___| |_____   |_|    "
            echo -e "${NC}"
            echo -e "${WHITE}${YELLOW}Veiler${NC} version 1.2.4${NC}"
    ;;
    search)
        shift
        FOUNDPACKAGES=""
        FOUNDPACKAGESVERSION=""
        FOUNDPACKAGESDESC=""
        FOUNDPACKAGESINSTALLED=""
        if [ -z $1 ]; then
            echo -e "${ORANGE}Error: ${WHITE}No package was provided!${NC}"
        fi
        if [ $VEILERSKIPDESC -eq 1 ]; then
            COUNT=0
            for((i=1; i <= $#; i++)){
                PACKAGES=$(ls -d /var/db/Veiler/sync/*${!i}* 2> /dev/null)
                for PACKAGE in $PACKAGES; do
                    if [ -f $PACKAGE/info ]; then
                        source $PACKAGE/info 
                        FOUNDPACKAGES[$COUNT]="$MOONPKGNAME"
                        FOUNDPACKAGESVERSION[$COUNT]="$MOONPKGVERSION"
                        FOUNDPACKAGESDESC[$COUNT]="$DESC"
                        if [ -n ${FOUNDPACKAGES[$COUNT]} ]; then
                            if [ -d "/var/db/Veiler/local/${FOUNDPACKAGES[$COUNT]}" ]; then
                                FOUNDPACKAGESINSTALLED[$COUNT]=" ${WHITE}||| ${YELLOW}Installed : ${WHITE}Yes${NC}"
                            else
                                FOUNDPACKAGESINSTALLED[$COUNT]=" ${WHITE}||| ${YELLOW}Installed : ${WHITE}No${NC}"
                            fi  
                            ((COUNT++))
                        fi
    
                    fi
                done
            }   
            for((i=0; i < ${#FOUNDPACKAGES[@]}; i++)){
                echo -ne "${WHITE}${FOUNDPACKAGES[$i]}${NC}"
                echo -e "${FOUNDPACKAGESINSTALLED[$i]}"
                echo -e "\t${WHITE}${FOUNDPACKAGESDESC[$i]}${NC}"
            } | more
        else
            COUNT=0
            for((i=1; i <= $#; i++)){
                PACKAGES=$(ls /var/db/Veiler/sync/)
                for PACKAGE in $PACKAGES; do
                    if [ -f /var/db/Veiler/sync/$PACKAGE/info ]; then 
                        source /var/db/Veiler/sync/$PACKAGE/info 
                        FOUNDPACKAGES[$COUNT]=$(echo $MOONPKGNAME | grep "${!i}")
                        FOUNDPACKAGESDESC[$COUNT]=$(echo $DESC | grep "${!i}")
                        if [[ -n "${FOUNDPACKAGES[$COUNT]}" || -n "${FOUNDPACKAGESDESC[$COUNT]}" ]]; then
                            FOUNDPACKAGES[$COUNT]="$MOONPKGNAME"
                            FOUNDPACKAGESVERSION[$COUNT]="$MOONPKGVERSION"
                            if [ -d "/var/db/Veiler/local/${FOUNDPACKAGES[$COUNT]}" ]; then
                                FOUNDPACKAGESINSTALLED[$COUNT]=" ${WHITE}||| ${YELLOW}Installed : ${WHITE}Yes${NC}"
                            else
                                FOUNDPACKAGESINSTALLED[$COUNT]=" ${WHITE}||| ${YELLOW}Installed : ${WHITE}No${NC}"
                            fi  
                            ((COUNT++))
                            unset MOONPKGNAME MOONPKGVERSION DESC
                        fi
                    fi
                done
            }
            for((i=0; i < ${#FOUNDPACKAGES[@]}; i++)){
                echo -ne "${WHITE}${FOUNDPACKAGES[$i]} ${NC}"
                echo -ne "${GRAY}(${FOUNDPACKAGESVERSION[$i]})${NC}"
                echo -e "${FOUNDPACKAGESINSTALLED[$i]}"
                echo -e "\t${WHITE}${FOUNDPACKAGESDESC[$i]}${NC}"
            } | more
        fi
    ;;
    sync)
        echo -e "${YELLOW}Important: ${WHITE}||| Syncing package repo${NC}"
        if [ -d /usr/lib/Veiler ]; then
            pushd /usr/lib/Veiler &> /dev/null
            trap 'echo -e "${ORANGE}Error: ${WHITE}Could not sync repo!${NC}"; exit 1' ERR
            set -e
            if [ ! -d Veiler ]; then
                git clone https://github.com/ilovetrees242/Veiler.git
                rm -rf Veiler/*
                pushd Veiler &> /dev/null
                git restore db.tar.gz
                popd &> /dev/null
            fi
            if [ "$VEILERQUIET" -eq 0 ]; then
                pushd Veiler &> /dev/null
                git pull origin main
                tar -C /var/db/Veiler/ --strip-components=1 -xvf db.tar.gz
            else
                pushd Veiler &> /dev/null
                git pull origin main &> /dev/null
                tar -C /var/db/Veiler/ --strip-components=1 -xf db.tar.gz
            fi
            set +e
            popd &> /dev/null
        else
            echo -e "${ORANGE}Error: ${WHITE}The package manager is not installed. Run the installation script again${NC}"
        fi
    ;;
    rmpkg)
        shift
        if [ $(id -u) -ne 0 ]; then
            echo -e "${YELLOW}Notice: ${WHITE}You have to become root in order to perform this action.${NC}"
            exit 1
        elif [ -z "$1" ]; then
            echo -e "${ORANGE}Error: ${WHITE}No package was provided!${NC}"
            exit 1
        fi
        PACKAGES=()
        for((i=1; i <= $#; i++)){
            PACKAGES[$((i-1))]=$(find /var/cache/Veiler -name "build-"${!i}"-*.*")
        }
        if [ -z "${PACKAGES[*]}" ]; then
            echo -e "${ORANGE}Error: ${WHITE}No occurences of the following packages could be found${NC}"
            exit 1
        fi
        echo -e "${YELLOW}Notice: ${WHITE}The following occurences were found: ${NC}"
        echo ${PACKAGES[@]}
        if [ $VEILERASK -eq 1 ]; then
            echo -ne "${YELLOW}Important: ${WHITE}Are you sure you would like to ${ORANGE}delete${WHITE} them?[y/n]: ${NC}"
            read -n 1
            if [ "$REPLY" == "y" ]; then
                true; echo
            elif [ "$REPLY" == "n" ]; then
                echo; exit 0
            fi
        fi
        trap 'echo -e "${ORANGE}Error: ${WHITE}Could not delete one or more occurences${NC}"; exit 1' ERR
        for((i=0; i < ${#PACKAGES[@]}; i++)){
            if [ $VEILERQUIET -eq 1 ]; then
                rm -rf ${PACKAGE[$i]}
            else
                rm -rfv ${PACKAGE[$i]}
            fi
        }
        echo -e "${YELLOW}Notice: ${WHITE}Successfully deleted all the occurences for: $@${NC}"
    ;;
	*)
        if [ -z $1 ]; 
            then echo -e "${ORANGE}Error: ${WHITE}No action specified!${NC}"; 
        else
            echo -e "${ORANGE}Error: ${WHITE}Invalid action ${YELLOW}$1${WHITE} specified!${NC}"
        fi
        $0 help
	;;
esac
