        else
            ((TOTALUNINSTSIZE=TOTALUNINSTSIZE/1024))
            echo -e "\n${DARKBLUE}***${BLUE} Total uninstalled size: ${WHITE}$TOTALUNINSTSIZE${NC} KiB"
