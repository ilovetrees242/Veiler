#!/bin/bash
PATH="$PATH:/etc/VeilerTools/usr/bin/"
PKGREPO="https://ilovetrees242.github.io/DevHelp/Website/Packages"
VEILERTESTS=0
VEILERQUIET=0
VEILERDOC=0
VEILERASK=0
YELLOW='\033[1;33m'
ORANGE='\033[0;33m'
WHITE='\033[1;37m'
GRAY='\033[0;37m'
DARKGRAY='\033[1;30m'
NC='\033[0m'

PROCESSID=""
PACKAGES=""
PACKAGEBUFFER=""
DEPSBUFFER=""
DEPS=""

trap 'stop_animation' TERM 
trap 'echo -e "\n${YELLOW}Interrupted${NC}"; stop_animation; exit 1' INT

play_animation(){
    while true; do
        printf "\r$1${WHITE}   ${NC}"; sleep 0.1
        printf "\r$1${WHITE}.  ${NC}"; sleep 0.1
        printf "\r$1${WHITE}.. ${NC}"; sleep 0.1
        printf "\r$1${WHITE}...${NC}"; sleep 0.1
    done &
    PROCESSID=$!
}
second_animation(){
    while true; do
        printf "\r$1${WHITE} [/]${NC}"; sleep 0.2
        printf "\r$1${WHITE} [-]${NC}"; sleep 0.2
        printf "\r$1${WHITE} [\\]${NC}"; sleep 0.2
        printf "\r$1${WHITE} [-]${NC}"; sleep 0.2
    done &
    PROCESSID=$!
}
stop_animation(){
    if [ -n "$PROCESSID" ]; then kill $PROCESSID; fi
    echo
}
package_check(){
    if [ $(id -u) != 0 ]; then
        echo -e "${ORANGE}You are not root! run as root with: ${WHITE}sudo ${YELLOW}$0${NC}"
        exit 1
    fi
    play_animation "\r${YELLOW}Notice: ${WHITE}Checking if required packages are installed on your computer${NC}"
    for PACKAGE in find bash wget awk gcc make patch grep tar sed; do
        $PACKAGE --version &> /dev/null 
        if [ $? -eq 127 ]; then
            echo -e "${ORANGE}Warning: ${YELLOW}$PACKAGE${WHITE} is not installed on your system! Veiler will use prebuilt binaries from the tool directory.${NC}"
            PATH=$PATH:/usr/lib/Veiler/Tools/usr/bin/
        fi
        sleep 0.1
    done
    stop_animation
}
clean(){
    for directory in $(find /var/cache/Veiler/ -type d | sed '1d'); do
        rm -rfv "${directory}"
    done
}
uninstalldb(){
    LINENUMBER="$(cat -n /var/db/Veiler/package.db | grep -w "$1" | awk '{print $1}')"
    sed -i "${LINENUMBER} s@yes@no@" /var/db/Veiler/package.db
}
installdb(){
    LINENUMBER="$(cat -n /var/db/Veiler/package.db | grep -w "$1" | awk '{print $1}')"
    sed -i "${LINENUMBER} s@no@yes@" /var/db/Veiler/package.db
}
changever(){
    LINENUMBER="$(cat -n /var/db/Veiler/package.db | grep -w "$1" | awk '{print $1}')"
    sed -i "${LINENUMBER} s@$(grep -w "$1" /var/db/Veiler/package.db | awk '{print $3}')@${MOONPKGVERSION}@" /var/db/Veiler/package.db 
}
for(( i=1; i <= $#; i++ )){
    case ${!i} in
        --quiet)
            if [ $VEILERQUIET -eq 0 ]; then
                set -- ${@:1:$((i-1))} ${@:$((i+1))}
                VEILERQUIET=1
                i=0
            elif [ $VEILERQUIET -eq 1 ]; then
                echo -e "${ORANGE}Error: ${WHITE}Quiet mode already enabled!${NC}"; exit 1
            fi
        ;;
        --documentation)
            if [ $VEILERDOC -eq 0 ]; then 
                set -- ${@:1:$((i-1))} ${@:$((i+1))}
                VEILERDOC=1
                i=0
            elif [ $VEILERDOC -eq 1 ]; then
                echo -e "${ORANGE}Error: ${WHITE}Documentation already enabled!${NC}"; exit 1
            fi
        ;;
        --tests)
            if [ $VEILERTESTS -eq 0 ]; then
                set -- ${@:1:$((i-1))} ${@:$((i+1))}
                VEILERTESTS=1
                i=0
            elif [ $VEILERTESTS -eq 1 ]; then
                echo -e "${ORANGE}Error: ${WHITE}Tests are already enabled!${NC}"; exit 1
            fi
        ;;
        --ask)
            if [ $VEILERASK -eq 0 ]; then
                set -- ${@:1:$((i-1))} ${@:$((i+1))}
                VEILERASK=1
                i=0
            elif [ $VEILERASK -eq 1 ]; then
                echo -e "${ORANGE}Error: ${WHITE}Confirmation prompts are already enabled!${NC}"; exit 1
            fi
    esac
}
case $1 in
	unveil)
        shift
        if [ -z "$1" ]; then
            echo -e "${ORANGE}Error: ${WHITE}No package provided!${NC}"
            exit 1
        fi
        trap 'exit 1' INT
        package_check
        source /etc/veiler.conf
        play_animation "${YELLOW}Activity: ${WHITE}Checking if packages exist${NC}"
        for PACKAGE in "$@"; do
            if [ ! -d "/var/db/Veiler/sync/$PACKAGE" ]; then echo -e "${ORANGE}Error: ${WHITE}The requested package ${YELLOW}$PACKAGE${WHITE} could not be found on the database.${NC}"; stop_animation; exit 1; fi
        done
        stop_animation
        second_animation "${YELLOW}Important: ${WHITE}Calculating dependencies${NC}"
        pushd /var/db/Veiler/sync/ > /dev/null
        PKGCOUNT=0 
        for PACKAGE in "$@"; do
            PACKAGES[$PKGCOUNT]=$PACKAGE
((PKGCOUNT++))
        done
        for((i=0; i < ${#PACKAGES[@]}; i++)){
            PACKAGEBUFFER[$i]=${PACKAGES[$i]}
        } 
        # PACKAGES contains the packages which actually need to installed
        # PACKAGEBUFFER contains the packages whos depdencies are being checked
        # DEPS contains the all the found depedencies of all packages generated by the graph
        # DEPSBUFFER contains the packages whos dependencies will be checked after the next iteration
        
        DEPCNTR=0
        DEPBUFCNTR=0
        # which neofetch
        # Stage 1 : which neofetch
        # stage 2 : bash bash
        # Stage 3 : ncurses ncurses
        # Stage 4 : 
        while [ ! -z $PACKAGEBUFFER ]; do
            for PACKAGE in ${PACKAGEBUFFER[@]}; do 
                while read DEPENDENCY; do
                    if [ ! -d "/var/db/Veiler/local/$DEPENDENCY" ]; then 
                        DEPS[$DEPCNTR]=$DEPENDENCY
                        DEPSBUFFER[$DEPBUFCNTR]=$DEPENDENCY
                        ((DEPCNTR++))
                        ((DEPBUFCNTR++))
                    fi
                done < "/var/db/Veiler/sync/$PACKAGE/dependencies"
            done
            for((i=0; i < ${#PACKAGEBUFFER[@]}; i++)){
                PACKAGEBUFFER[$i]=""
            }
            for((i=0; i < ${#DEPSBUFFER[@]}; i++)){
                PACKAGEBUFFER[$i]=${DEPSBUFFER[$i]}
            }
            for((i=0; i < ${#DEPSBUFFER[@]}; i++)){
                DEPSBUFFER[$i]=""
            }
            DEPBUFCNTR=0
        done
        echo ${DEPS[@]}
        popd > /dev/null
        # To do : Depedency resolver with DFS and toposort algorithm
        sleep 10 && stop_animation
        if [ $VEILERQUIET -eq 0 ]; then
            echo -e "${YELLOW}Changing directory to /var/cache/Veiler...${NC}"
            pushd /var/cache/Veiler && clean
            echo -e "${YELLOW}Fetching package(s)...${NC}"
            for Package in $@; do
                if [ ! -f "$Package.tar.gz" ]; then
                    wget "$PKGREPO/$Package.tar.gz"
                fi
                ls "$Package.tar.gz" &> /dev/null
                if [ $? -ne 0 ]; then echo -e "${ORANGE}Package ${WHITE}$Package${ORANGE} does not exist!${NC}"; exit 1; fi
            done
            echo -e "${YELLOW}Extracting the package build tarballs...${NC}"
            for Package in $@; do
                tar xvf "$Package.tar.gz"
            done
            echo -e "${YELLOW}Checking if the package(s) are already installed...${NC}"
            for Package in $@; do
                pushd $Package
                    touch compare.txt
                    VERSION="$(./MOONBUILD version)" 
                    INSTVERSION="$(grep -w "$Package" /var/db/Veiler/package.db | awk '{print $3}')"
                    echo "$VERSION" >> compare.txt
                    echo "$INSTVERSION" >> compare.txt
                    NEWVER=$(sort -Vr compare.txt | head -n1 | tail -n1)
                    if [ "$NEWVER" != "$INSTVERSION" ]; then
                        echo -e "${YELLOW}${WHITE}$Package(${GRAY}$VERSION)${YELLOW} will be upgraded to ${WHITE}$Package(${GRAY}$NEWVER)${NC}"
                    elif [ "$NEWVER" == "$INSTVERSION" ]; then
                        echo -e "${ORANGE}${WHITE}$Package${ORANGE} is already installed ${GRAY}(version $VERSION)${ORANGE}, not installing again.${NC}"
                        shift
                    fi
                    rm -f compare.txt
                popd
            done
            if [ $# -ne 0 ]; then echo -e "${YELLOW}Installing the package(s)...${NC}"; fi
            set -e
            for Package in $@; do
                pushd $Package
                    echo -e "${YELLOW}Checking for depedencies...${NC}"
                    source ./MOONBUILD chkdeps
                    trap "${ORANGE}Failed to build ${WHITE}$Package.${NC}" ERR
                    source ./MOONBUILD build
                    trap "${ORANGE}Failed to install ${WHITE}$Package.${NC}" ERR
                    source ./MOONBUILD install
                    installdb $Package
                    changever $Package
                popd
            done
            set +e
            popd
        else
            echo 
        fi
    ;;
	veil)
        package_check
        source /etc/veiler.conf
        if [ -z "$2" ]; then
            echo -e "${YELLOW}Package name not specified!${NC}"
            exit 1
        fi
        shift
        if [ "$VEILERQUIET" -eq 1 ]; then
            echo -e "${YELLOW}Changing directory to /var/cache/Veiler...${NC}"
            pushd /var/cache/Veiler &> /dev/null && clean &> /dev/null
            if [ $# -ge 2 ]; then
                echo "\033[s"
                while true; do
                    echo -ne "\r${ORANGE}Checking if packages exist   ${NC}"; sleep 0.2; echo "\033[u"
                    echo -ne "\r${ORANGE}Checking if packages exist.  ${NC}"; sleep 0.2; echo "\033[u"
                    echo -ne "\r${ORANGE}Checking if packages exist.. ${NC}"; sleep 0.2; echo "\033[u"
                    echo -ne "\r${ORANGE}Checking if packages exist...${NC}"; sleep 0.2; echo "\033[u"
                done &
                PROCESSID=$!
                wget "$PKGREPO$1.tar.gz" &> /dev/null 
                if [ $? -eq 8 ]; then
                    echo -e "${YELLOW}Package $1 not found!${NC}"
                elif [ $? -eq 0 ]; then
                    echo -e "${WHITE}->${YELLOW}Package ${WHITE}$1${YELLOW} found${NC}"
                else
                    echo -e "${YELLOW}An unknown error was encountered while checking if packages exist. Manual intervention required.${NC}"
                fi
            else
                while true; do
		            echo -ne "\r${ORANGE}Checking if the package ${YELLOW}$1${ORANGE} exists   ${NC}"; sleep 0.2
		            echo -ne "\r${ORANGE}Checking if the package ${YELLOW}$1${ORANGE} exists.  ${NC}"; sleep 0.2
		            echo -ne "\r${ORANGE}Checking if the package ${YELLOW}$1${ORANGE} exists.. ${NC}"; sleep 0.2
		            echo -ne "\r${ORANGE}Checking if the package ${YELLOW}$1${ORANGE} exists...${NC}"; sleep 0.2
                done &
                PROCESSID=$!
		        wget "$PKGREPO$1.tar.gz" &> /dev/null && kill $PROCESSID && echo
		        case $? in
		            8)
				        echo -e "${YELLOW}Package ${WHITE}$1${WHITE}does not exist!${NC}"
                        kill $PROCESSID
		    	    ;;
                    0)
                    echo -e "\n${ORANGE}Package ${WHITE}$1${WHITE} found!${NC}"
                    echo -e "${YELLOW}Checking if its already uninstalled...${NC}"
                    if [ $(cat /var/db/Veiler/package.db | grep $1 | awk '{print $2}') == "no" ]; then
                        echo -e "${WHITE}The package ${YELLOW}$1${WHITE} is already uninstalled.${NC}"
                        exit 1
                    else
                        echo -e "${WHITE}Ok. The package ${YELLOW}$1${WHITE} is going to be uninstalled.${NC}"
                        if [ $VEILERASK -eq 1 ]; then
                            echo -ne "${WHITE}Proceed with the uninstallation?[y/n]${NC}"
                            read -n 1
                            if [ $REPLY == "n" ]; then
                                echo -e "\n${YELLOW}Ok."
                                exit 0
                            fi
                            if [[ $REPLY != "n" && $REPLY != "y" ]]; then
                                echo -e "\n${YELLOW}Please enter a valid choice."
                                exit 1
                            fi
                        fi
                    fi
			        echo -e "${YELLOW}Uninstalling ${WHITE}$1${YELLOW} in${NC}"
			        for i in 1 2 3 4 5 ; do
                        printf "${WHITE}%d${NC}" "$i"
			            for j in 1 2 3; do
                            sleep 0.1
                            printf "${YELLOW}.${NC}"
                        done
                        sleep 1
			        done
                    echo
                    while true; do
                        echo -ne "\r${ORANGE}Extracting the build tarball   ${NC}"; sleep 0.2
                        echo -ne "\r${ORANGE}Extracting the build tarball.  ${NC}"; sleep 0.2
                        echo -ne "\r${ORANGE}Extracting the build tarball.. ${NC}"; sleep 0.2
                        echo -ne "\r${ORANGE}Extracting the build tarball...${NC}"; sleep 0.2
                    done &
                    PROCESSID=$!
                    tar xf "$1.tar.gz" && kill $PROCESSID && echo -e "\n${YELLOW}->Successfully extracted $1.tar.gz${NC}"
                    if [ $? -ne 0 ]; then echo -e "${ORANGE}An error was encountered while extracting!${NC}"; kill $PROCESSID; exit 1; fi
					pushd "$1" &> /dev/null
				        source ./MOONBUILD uninstall
                        uninstalldb $1
				    popd &> /dev/null
			        ;;
                    *)
                        echo -e "${YELLOW}An unknown error has been encountered. Manual intervention is required.${NC}"
                        popd &> /dev/null
                        exit 1
                    ;;
		        esac
            popd &> /dev/null
            fi
        else
            echo -e "${YELLOW}Changing directory to /var/cache/Veiler..."; sleep 2
            pushd /var/cache/Veiler && clean
            if [ $# -ge 2 ]; then
                # TO DO : Build commands for multiple packages
                xx
            else
                echo -e "${ORANGE}Checking if the package ${YELLOW}$1${ORANGE} exists...${NC}"; sleep 0.2
                PROCESSID="$!"
                wget $PKGREPO$1.tar.gz
                case $? in 
                    8)
                        echo -e "${YELLOW}Package ${WHITE}$1${YELLOW} does not exist!${NC}"
                        exit 1
                    ;;                    
                    0)
                        echo -e "\n${ORANGE}Package ${WHITE}$1${WHITE} found!${NC}"
                        if [ $(cat /var/db/Veiler/package.db | grep $1 | awk '{print $2}') == "no" ]; then
                            echo -e "${WHITE}The package ${YELLOW}$1${WHITE} is already uninstalled.${NC}"
                            exit 1
                        fi
    			        echo -e "${YELLOW}Uninstalling ${WHITE}$1${YELLOW} in${NC}"
	    		        for i in 1 2 3 4 5 ; do
                            printf "${WHITE}%d${NC}" "$i"
			                for j in 1 2 3; do
                                sleep 0.1
                                printf "${YELLOW}.${NC}"
                            done
                        sleep 1
			            done
                        echo
                        printf "${YELLOW}Extracting the build tarball now...${NC}"
                        tar xvf "$1.tar.gz"
                        if [ $? -ne 0 ]; then echo -e "${ORANGE}An error was encountered while extracting!${NC}"; exit 1; fi
                        pushd "$1"
                            source ./MOONBUILD uninstall
                            uninstalldb $1
                        popd
                    ;;
                    *)
                        echo -e "${ORANGE}An unknown error was encountered while downloading the build tarball.${NC}"
                        exit 1
                esac
            fi
         fi
	;;
	strengthen)
        # TO DO: Later, add a feature to update packages installed on system if new version has been released and is greater than installed version
        source /etc/veiler.conf
        if [ ! -d /run/Veiler ]; then 
            mkdir -p /run/Veiler/Tarballs
        fi
        sudo cp -ra /var/cache/Veiler/*.tar.gz /run/Veiler/
        pushd /run/Veiler
            
	;;
    info)
        if [ -z $2 ]; then
            echo -e "${YELLOW}No package provided.${NC}"
            exit 1
        fi
        shift
        for((i=0; i < $#; i++)){
            if [ ! -d "/var/db/Veiler/local/${1}" ]; then echo -e "${ORANGE}Error:${NC} ${WHITE}Specified package ${YELLOW}${1} ${WHITE}does not exist!${NC}"; exit 1; fi
            echo "Name: $(sed -n "s/MOONPKGNAME=//; s/"$//; s/^"//p") /var/db/Veiler/local/${1}"
            shift
        }
    ;;
	help)
        echo -e "${YELLOW}$0 Usage: $0 <COMMAND> <OPTIONS> ${NC}"
		echo -e "${WHITE}$0 unveil|veil <OPTIONS> [PACKAGE]${NC}"
		echo -e "${WHITE}$0 Options:${NC}" 
	   echo -e "${GRAY}--verbose${NC}${WHITE} : Displays verbose output${NC}"
       echo -e "${GRAY}--quiet${NC}${WHITE} : Displays quiet output, not too detailed.${NC}"
	   echo -e "${GRAY}--documentation${NC}${WHITE} : Enables documentation (this might install extra dependencies)${NC}"
	   echo -e "${GRAY}--test${NC}${WHITE}: Enables test harnesses${NC}" 
       echo -e "${GRAY}--ask${NC}${WHITE}: Use confirmation prompts before performing actions related to the entire package${NC}"
		echo -e "${WHITE}$0 unveil: Installs a package from source.${NC}"
		echo -e "${WHITE}$0 veil  : Uninstalls a package installed on the system${NC}"
		echo -e "${WHITE}$0 strengthen: Updates all packages installed on the system${NC}"
		echo -e "${WHITE}$0 help: Displays this output${NC}"
        echo -e "${WHITE}$0 version: Display package manager version${NC}"
        echo -e "${WHITE}$0 info: Display information about a package${NC}"
		
	;;
    version)
            echo -e "Veiler development version. v0.0.1-r2"
    ;;
    sync)
    ;;
	*)
        if [ -z $1 ]; 
            then echo -e "${WHITE}No action specified!${NC}"; 
        else
            echo -e "${WHITE}Invalid action ${YELLOW}$1${WHITE} specified!${NC}"
        fi
        $0 help
	;;
esac
