#!/bin/bash
# Main package manager related variables
declare -a OPTIONS PACKAGES
VEILERTESTS=0
VEILERQUIET=0
VEILERDOC=0
VEILERASK=0
VEILERONLYBUILD=0
VEILERNOROOT=0
VEILERSKIPDESC=0
VEILERSKIPDEPS=0
VEILERSKIPCLEAN=0
VEILERSKIPINST=0
VEILERSKIPINTEGRITY=0
VEILERERREXIT=0
VEILERMBE=0
VEILERDEST="/"
VEILERCACHEPATH="/var/cache/Veiler/"
VEILERDBPATH="/var/db/Veiler"
VEILERCONFIGPATH="/etc/Veiler/veiler.conf"
PROCESSID=""
PKGREPO="https://ilovetrees242.github.io/Supplements/Website/Packages"
USEFLAGS=""
GLOBALUSEFLAGS=()
LOCALUSEFLAGS=()

# Colors
DARKBLUE='\033[0;34m'
BLUE='\033[1;34m'
RED='\033[1;31m'
YELLOW='\033[1;33m'
ORANGE='\033[0;33m'
WHITE='\033[1;37m'
GRAY='\033[0;37m'
DARKGRAY='\033[1;30m'
NC='\033[0m'

# Package handling related variables
declare -a PKGNAME PKGVERSION
PACKAGES=""
PACKAGEBUFFER=""
VICTIMPACKAGES=""
DEPSBUFFER=()
DEPS=()
VICTCNTR=0
DEPCNTR=0
DEPBUFCNTR=0

ADDITIONALDEPS=()
UPGRADEDPACKAGES=()
UPGRADEDPACKAGESLOCALVERSION=()
UPGRADEDPACKAGESSYNCVERSION=()
LOCALPKGVERSIONS=()
SYNCPKGVERSIONS=()

# Space and size related variables
TOTALDSR=0
TOTALINSTSIZE=0
TOTALUNINSTSIZE=0
TOTALDOWNLOADSIZE=0
TOTALUPGRADESIZE=0
TOTALUPGRADESIZEWODOC=0
WODOCINSTSIZE=0
SIZEBUFFER=0

. $VEILERCONFIGPATH

trap 'veiler_stop_animation' TERM 
trap 'echo -e "\n${YELLOW}Interrupted${NC}"; veiler_stop_animation; exit 1' INT

# --- Functions ---
play_animation(){
    while true; do
        printf "\r$1${WHITE}   ${NC}"; sleep 0.1
        printf "\r$1${WHITE}.  ${NC}"; sleep 0.1
        printf "\r$1${WHITE}.. ${NC}"; sleep 0.1
        printf "\r$1${WHITE}...${NC}"; sleep 0.1
    done &
    PROCESSID=$!
}
second_animation(){
    while true; do
        printf "\r$1${WHITE} [/]${NC}"; sleep 0.2
        printf "\r$1${WHITE} [-]${NC}"; sleep 0.2
        printf "\r$1${WHITE} [\\]${NC}"; sleep 0.2
        printf "\r$1${WHITE} [-]${NC}"; sleep 0.2
    done &
    PROCESSID=$!
}
veiler_stop_animation(){
    if [ -n "$PROCESSID" ]; then kill "$PROCESSID" &> /dev/null; echo; fi
}
clean(){
    if [ $VEILERSKIPCLEAN -eq 0 -a -d $VEILERCACHEPATH ]; then
        for directory in $(find $VEILERCACHEPATH -type d | sed '1d'); do
            rm -rf "${directory}" || log_err "Could not clean cache!"
        done        
    else
        return
    fi
}
log_warn(){
    echo -e "${ORANGE}WARNING >>>${WHITE} $1${NC}"
}
log_err(){
    echo -e "${RED}ERROR >>>${WHITE} $1${NC}"; exit 1 
}
log_info(){
    case $1 in
        tip)
            echo -e "${BLUE}Tip >>>${WHITE} $2${NC}"
        ;;
        imp)
            echo -e "${YELLOW}Important >>>${WHITE} $2${NC}"    
        ;;
        notice)
            echo -e "${YELLOW}Notice >>>${WHITE} $2${NC}"    
        ;;
        activity)
            echo -e "${YELLOW}Activity >>>${WHITE} $2${NC}"    
        ;;
    esac
}
checkifroot(){
    if [ $VEILERNOROOT -eq 0 -a $(id -u) -ne 0 ]; then
        log_err "You have to become root to perform this action."
    fi
}
checkIfAlreadyInstalled(){
    declare -a local newPackages
    newPackages=()
    for PACKAGE in $@; do
        if [ ! -d "$VEILERDBPATH/local/$PACKAGE" ]; then
            newPackages+=( $PACKAGE )
        fi
    done
    echo ${newPackages[@]}
}
getBuildTarballs(){
    log_info imp "Fetching package(s)..."
    for((i=0; i < ${#PKGNAME[@]}; i++)){
        if [ ! -f "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}".tar.gz" ]; then
            if [ $VEILERQUIET -eq 0 ]; then
                wget -nv --show-progress "$PKGREPO/build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}".tar.gz"
            else
                wget -q --show-progress "$PKGREPO/build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}".tar.gz"
            fi 
            if [ $? -ne 0 ]; then 
                log_err "Could not download the package ${YELLOW}${PKGNAME[$i]}${WHITE}!" && log_info tip "Maybe try running $0 ${GRAY}sync?${NC}"
            fi
        fi
    }
}
extractBuildTarballs(){
    log_info imp "Extracting the package build tarball(s)..."
    for((i=0; i < ${#PKGNAME[@]}; i++)){
        echo -e "${GRAY}($((i+1))/${#PKGNAME[@]}) ${WHITE}Extracting ${YELLOW}>>> ${WHITE}${PKGNAME[$i]}"
        if [ $VEILERQUIET -eq 1 ]; then
            tar xf "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}".tar.gz"
        else
            tar xvf "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}".tar.gz"
        fi || log_err "${GRAY}($((i+1))/${#PKGNAME[@]})${WHITE} Could not extract the build tarball for ${RED}>>> ${WHITE}${PKGNAME[$i]}"
    }
}
getSources(){
    log_info imp "Getting source(s)..."
    for((i=0; i < ${#PKGNAME[@]}; i++)){
        pushd "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}"" &> /dev/null
            source ./MOONBUILD getpkg || log_err "${GRAY}($((i+1))/${#PKGNAME[@]})${WHITE} Failed to download the source for ${PKGNAME[$i]}"
        popd &> /dev/null
    }
}
verifyChecksums(){
    for((i=0; i < ${#PKGNAME[@]}; i++)){
        if [ $VEILERSKIPINTEGRITY -eq 0 ]; then
            echo -ne "\r${YELLOW}Important >>> ${GRAY}("$((i+1))"/"${#PKGNAME[@]}") ${WHITE}Verifying package integrity ${DARKBLUE}|||${WHITE} ${PKGNAME[$i]}                                     ${NC}"
            pushd "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}"" &> /dev/null
                sha256sum -c --quiet integrity.sha256 || log_err "${GRAY}($((i+1))/${#PKGNAME[@]})${WHITE} Failed to verify package integrity for package ${RED}>>>${WHITE} ${PKGNAME[$i]}"
            popd &> /dev/null
        fi
        tar -cf "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}".tar.gz" "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}"" || log_err "${GRAY}($((i+1))/${#PKGNAME[@]})${WHITE}Failed to archive the package" 
        sleep 0.1
    }; echo
}
buildPackages(){
    export MAKEFLAGS="$MAKEFLAGS"
    USEFLAGS=( ${USEFLAGS[@]} )
    log_info imp "Building the package(s)..."
    GLOBALUSEFLAGS=( ${USEFLAGS[@]} )
    for((i=0; i < ${#PKGNAME[@]}; i++)){
        if [ $VEILERERREXIT -eq 0 ]; then trap 'log_err "${GRAY}($((i+1))/${#PKGNAME[@]})${WHITE} Failed to build or install the package ${RED}>>> ${WHITE}${PKGNAME[$i]}"' ERR; fi
        echo -e "${GRAY}($((i+1))/${#PKGNAME[@]})${WHITE} Building ${BLUE}>>> ${WHITE}${PKGNAME[$i]}${NC}"
        pushd "build-${PKGNAME[$i]}-${PKGVERSION[$i]}" &> /dev/null
            (
                if [ -s /etc/Veiler/package.use ]; then
                    while read pkg; do
                        if [ $(echo $pkg | sed 's/->.*//; s/^s//g') == "${PKGNAME[$i]}" ]; then
                            USEFLAGS=( "$(echo $pkg | sed "s/.*->//; s/^\s*//")" )
                            USEFLAGS=( $USEFLAGS )
                        fi
                    done < /etc/Veiler/package.use
                fi
                source ./MOONBUILD build
                USEFLAGS=( ${GLOBALUSEFLAGS[@]} )
            )
            if [ $VEILERONLYBUILD -eq 0 ]; then 
                echo -e "${GRAY}($((i+1))/${#PKGNAME[@]})${WHITE} Installing ${YELLOW}>>> ${WHITE}${PKGNAME[$i]}${NC}"
                source ./MOONBUILD install
                cp -r "$VEILERDBPATH/sync/${PKGNAME[$i]}" "$VEILERDBPATH/local"
                cd "${PKGNAME[$i]}-${PKGVERSION[$i]}"/DEST
                if [ ! -d $VEILERDBPATH/local/${PKGNAME[$i]} ]; then mkdir $VEILERDBPATH/local/${PKGNAME[$i]}; fi
                find . ! -type d | sed 's/^.//' > $VEILERDBPATH/local/${PKGNAME[$i]}/files 
                if [ -s $VEILERDBPATH/sync/${PKGNAME[$i]}/docfiles ]; then
                    if [ $VEILERDOC -eq 0 ]; then
                        while read file; do
                            if [ $VEILERQUIET -eq 1 ]; then
                                rm -f DEST/$file
                            else
                                rm -fv DEST/$file
                            fi
                        done < $VEILERDBPATH/sync/${PKGNAME[$i]}/docfiles
                    fi
                fi
                if [ ! -d $VEILERDEST ]; then mkdir -p $VEILERDEST; fi
                if [ $VEILERQUIET -eq 1 ]; then
                    cp -fra ./* $VEILERDEST
                else
                    cp -frva ./* $VEILERDEST
                fi
            fi
        popd &> /dev/null
        echo -e "${GRAY}($((i+1))/${#PKGNAME[@]}) ${WHITE}Completed the build${DARKBLUE} >>> ${WHITE}${PKGNAME[$i]}${NC}"
    }
    unset MAKEFLAGS
    trap - ERR
}
uninstallPackages(){
    log_info imp "Uninstalling the package(s)"
    for((i=0; i < ${#PKGNAME[@]}; i++)){
        echo -e "${GRAY}($((i+1))/${#PKGNAME[@]}) ${WHITE}Uninstalling ${BLUE}>>> ${WHITE}${PKGNAME[$i]}${NC}"
        if [ $VEILERERREXIT -eq 0 ]; then trap 'log_err "${GRAY}($((i+1)/${#PKGNAME[@]}))${WHITE} Failed to uninstall the package ${RED}>>>${WHITE} ${PKGNAME[$i]}"' ERR; fi
        if [ -f $VEILERDBPATH/local/${PKGNAME[$i]}/files ]; then
            while read file; do
                if [ $VEILERQUIET -eq 1 ]; then
                    rm -f "$file"
                else
                    rm -fv "$file"
                fi
            done < $VEILERDBPATH/local/${PKGNAME[$i]}/files
        fi
        rm -rf "$VEILERDBPATH/local/${PKGNAME[$i]}"
        echo -e "${GRAY}($((i+1))/${#PKGNAME[@]}) ${WHITE}Successfully uninstalled ${DARKBLUE}>>> ${WHITE}${PKGNAME[$i]}${NC}"
    }
    trap - ERR
}
resolvedeps(){
    # --- Start dependency calculating ---
    if [ $VEILERSKIPDEPS -eq 0 ]; then
        second_animation "$(log_info imp "Calculating dependencies")"
        PACKAGES=( "$@" )
        USEFLAGS=( $USEFLAGS )
        GLOBALUSEFLAGS=( ${USEFLAGS[@]} )
        for PACKAGE in ${PACKAGES[@]}; do
            if [ ${#GLOBALUSEFLAGS[@]} -gt 0 -o -s /etc/Veiler/package.use ]; then
                (
                    if [ -s /etc/Veiler/package.use ]; then
                        while read pkg; do
                            if [ $(echo $pkg | sed 's/->.*//; s/\s//g') == "$PACKAGE" ]; then
                                BUFFER=( "$(echo $pkg | sed "s/.*->//; s/^\s*//")" )
                                USEFLAGS=$( $BUFFER )
                            fi
                        done < /etc/Veiler/package.use
                    fi
                    for FLAG in ${USEFLAGS[@]}; do
                        if [ -s "$VEILERDBPATH/sync/$PACKAGE/optdependencies" ]; then
                            while read pkg_line; do
                                if [ "$FLAG" == "$(echo $pkg_line | sed 's/ .*//')" ]; then
                                    PACKAGES+=( $(echo $pkg_line | sed 's/.* //' ) )
                                fi
                            done < "$VEILERDBPATH/sync/$PACKAGE/optdependencies"
                        fi
                    done
                    USEFLAGS=$( ${GLOBALUSEFLAGS[@]} )
                )
            fi
        done
        PACKAGEBUFFER=( ${PACKAGES[@]} )
        # PACKAGES contains the packages which actually need to installed
        # PACKAGEBUFFER contains the packages whos depdencies are being checked
        # DEPS contains the all the found dependencies of all packages generated by the graph
        # DEPSBUFFER contains the packages whos dependencies will be checked after the next iteration
        # VICTIMPACKAGES holds a single copy of every package

        # Example -> which neofetch, missing deps: bash, ncurses, readline
        # Contents of PACKAGEBUFFER->
        # Stage 1 : which neofetch
        # stage 2 : bash bash
        # Stage 3 : ncurses readline ncurses readline
        # Stage 4 : 
        # DEPS="which neofetch bash bash ncurses readline ncurses readline"
        # After deduplication
        # DEPS="which neofetch bash ncurses readline"
        # PACKAGES="readline ncurses bash neofetch which" ( DEPS copied to PACKAGES, then PACKAGES reversed)
        while [ ${#PACKAGEBUFFER[@]} -ne 0 ]; do
            for PACKAGE in ${PACKAGEBUFFER[@]}; do 
                if [ -f $VEILERDBPATH/sync/$PACKAGE/dependencies ]; then
                    while read DEPENDENCY; do
                        if [ ! -d "$VEILERDBPATH/local/$DEPENDENCY" ]; then 
                            DEPS+=( "$DEPENDENCY" )
                            DEPSBUFFER+=( "$DEPENDENCY" )
                        fi
                    done < "$VEILERDBPATH/sync/$PACKAGE/dependencies"
                fi
            done
            PACKAGEBUFFER=()
            PACKAGEBUFFER=( ${DEPSBUFFER[@]} )
            DEPSBUFFER=()
        done    
        PACKAGEBUFFER=( ${PACKAGES[@]} )
        PACKAGEBUFFER+=( ${DEPS[@]} )
        for((i=0; i < ${#DEPS[@]}; i++)){
            EXISTS=$(checkifexists ${DEPS[$i]})
            if [ $EXISTS == "no" ]; then
                ADDITIONALDEPS+=( ${DEPS[$i]} )
            fi
        }
        for((i=0; i < ${#PACKAGEBUFFER[@]}; i++)){
            EXISTS=$(checkifexists ${PACKAGEBUFFER[$i]})
            if [ $EXISTS == "no" ]; then
                VICTIMPACKAGES+=( ${PACKAGEBUFFER[$i]} )
            fi
        }
        BUFFER=${PACKAGEBUFFER[@]}
        for PACKAGE in ${VICTIMPACKAGES[@]}; do
            OCCURENCES=$(echo ${PACKAGEBUFFER[@]} | grep -ow "$PACKAGE" | wc -w)
            ((OCCURENCES--))
            for((i=0; i < $OCCURENCES; i++)){
                BUFFER=$(echo $BUFFER | sed "s@$PACKAGE@@1")
            }
        done
        # Reverse the packages to build in correct order
        PACKAGES=( $BUFFER )
        PACKAGES=( $(printf "%s\n" ${PACKAGES[@]} | tac) )
        veiler_stop_animation
        makepkgarray ${PACKAGES[@]}
    else
        makepkgarray "$@"
        return
    fi
    # --- End dependency calculating ---
}
makepkgarray(){
    PKGVERSION=()
    PKGNAME=()
    while [ $# -gt 0 ]; do
        if [ -f $VEILERDBPATH/sync/$1/info ]; then
            local BUFFERPKGVERSION="$(sed -n 's/^MOONPKGVERSION=//; s/"$//; s/^"//p' $VEILERDBPATH/sync/$1/info)"
            local BUFFERPKGNAME="$(sed -n 's/^MOONPKGNAME=//; s/"$//; s/^"//p' $VEILERDBPATH/sync/$1/info)"
        fi
        if [ -z "$BUFFERPKGVERSION" -a -z "$BUFFERPKGNAME" ]; then
            log_warn "No valid information related to ${YELLOW}$1${WHITE} could be found. Skipping this package..."
            shift
            continue
        elif [ -z "$BUFFERPKGVERSION" ]; then
            log_warn "No valid version could be found for ${YELLOW}$1${WHITE}. Skipping this package..." 
            shift
            continue
        elif [ -z "$BUFFERPKGNAME" ]; then
            log_warn "No valid name could be found for ${YELLOW}$1${WHITE}. Skipping this package..."
            shift
            continue
        fi
        PKGVERSION+=( "$BUFFERPKGVERSION" )
        PKGNAME+=( "$BUFFERPKGNAME" )
        BUFFERPKGVERSION=
        BUFFERPKGNAME=
        shift
    done
}
checkifexists(){
    for((i=0; i < ${#VICTIMPACKAGES[@]}; i++)){
        if [ "${VICTIMPACKAGES[$i]}" == "$1" ]; then
            echo "yes"; return 0;
        fi
    }
    echo "no"
}
# --- End Functions ---
while [ $# -gt 0 ]; do
    case $1 in 
        --*)
            OPTIONS+=($1)
            case $1 in
                --with-dest)
                    if [ -n $2 ]; then
                        OPTIONS+=($2); shift
                    else
                        log_err "The option ${GRAY}--with-dest${NC} requires an argument!"
                    fi
            esac
        ;;
        *)
            ARGUMENTS+=($1)
        ;;
    esac
    shift
done
# -- Parse options --
for((i=0; i < ${#OPTIONS[@]}; i++)){
    case ${OPTIONS[$i]} in
        --quiet)
            if [ $VEILERQUIET -eq 0 ]; then VEILERQUIET=1; else log_err "Quiet mode already enabled!"; fi
        ;;
        --documentation)
            if [ $VEILERDOC -eq 0 ]; then VEILERDOC=1; else log_err "Documentation already enabled!"; fi
        ;;
        --tests)
            if [ $VEILERTESTS -eq 0 ]; then VEILERTESTS=1; else log_err "Tests already enabled!"; fi
        ;;
        --ask)
            if [ $VEILERASK -eq 0 ]; then VEILERASK=1; else log_err "Confirmation prompts already enabled!"; fi
        ;;
        --skip-description)
            if [ $VEILERSKIPDESC -eq 0 ]; then VEILERSKIPDESC=1; else log_err "Description skipping already enabled!"; fi
        ;;
        --build-only)
            if [ $VEILERONLYBUILD -eq 0 ]; then VEILERONLYBUILD=1; else log_err "Build only mode already enabled!"; fi
        ;;
        --no-root)
            if [ $VEILERNOROOT -eq 0 ]; then VEILERNOROOT=1; else log_err "No root alreay enabled!"; fi
        ;;
        --with-dest)
            VEILERDEST=${OPTIONS[$((i+1))]}; ((i++))
        ;;            
        --skip-deps)
            if [ $VEILERSKIPDEPS -eq 0 ]; then VEILERSKIPDEPS=1; else log_err "Skipping dependencies already enabled!"; fi
        ;;
        --skip-clean)
            if [ $VEILERSKIPCLEAN -eq 0 ]; then VEILERSKIPCLEAN=1; else log_err "Skipping cleaning already enabled!"; fi
        ;;
        --skip-installed)
            if [ $VEILERSKIPINST -eq 0 ]; then VEILERSKIPINST=1; else log_err "Skipping installed packages already enabled!"; fi
        ;;
        --megabytes)
            if [ $VEILERMBE -eq 0 ]; then VEILERMBE=1; else log_err "Showing size in megabytes already enabled!"; fi
        ;;
        --skip-integrity)
            if [ $VEILERSKIPINTEGRITY -eq 0 ]; then VEILERSKIPINTEGRITY=1; else log_err "Skipping verifying package integrity is already enabled!"; fi
        ;;
        --no-errexit)
            if [ $VEILERERREXIT -eq 0 ]; then VEILERERREXIT=1; else log_err "Not exiting upon errors already enabled!"; fi
        ;;
        *)
            log_err "Invalid option ${GRAY}${OPTIONS[$i]}${NC}"
        ;;
    esac    
}
# -- End option parsing --
if [ $VEILERSKIPINST -eq 1 ]; then
    set -- $(checkIfAlreadyInstalled ${ARGUMENTS[@]})
else
    set -- ${ARGUMENTS[@]}
fi
if [ $(echo $VEILERCACHEPATH | cut -c1) != "/" ]; then
    log_err "Cache path must be absolute."
elif [ $(echo $VEILERDBPATH | cut -c1) != "/" ]; then
    log_err "DB path must be absolute."
fi
case $1 in
	unveil)
        shift
        if [ -z "$1" ]; then
            log_err "Nothing to install."
        fi
        checkifroot
        BUFFER=$(echo $VEILERDEST | cut -c1 )
        if [ $BUFFER != "/" ]; then
            log_warn "It is highly advised to use absolute paths instead of relative paths for installation of packages. If possible, please try to use absolute paths as much as you can. You can use \$PWD/<DESTDIR> to get an absolute path instead of a relative path. Using relative paths will most likely lead to breakages, for which I am not responsible."
            log_info imp "Proceeding to install in: "
            for i in 1 2 3 4 5; do
                echo -ne "$i... "
                sleep 2
            done
            echo -e "${NC}"
        fi
        if [ $VEILERONLYBUILD -eq 0 ]; then
            log_info notice "Packages will be installed in $VEILERDEST"
        fi
        play_animation "$(log_info activity "Checking if packages exist")"
        sleep 0.1
        for PACKAGE in "$@"; do
            if [ ! -d "$VEILERDBPATH/sync/$PACKAGE" ]; then veiler_stop_animation ; log_err "The requested package ${YELLOW}$PACKAGE${WHITE} could not be found on the database"; fi
        done
        veiler_stop_animation
        resolvedeps "$@"
        echo -ne "\n${YELLOW}Packages to be installed ${GRAY}(${#PKGNAME[@]}): ${NC}"
        for((i=0; i < ${#PKGNAME[@]}; i++)){
            if [ -f $VEILERDBPATH/local/"${PKGNAME[$i]}"/info -a -n "${PKGNAME[$i]}" ]; then
                LOCALPKGVERSION="$(sed -n 's/^MOONPKGVERSION=//; s/"$//; s/^"//p' $VEILERDBPATH/local/"${PKGNAME[$i]}"/info)"
                if [ "${PKGVERSION[$i]}" != "$LOCALPKGVERSION" ]; then
                    echo -ne "${WHITE}"${PKGNAME[$i]}" ${GRAY}("$LOCALPKGVERSION")${WHITE} -> "${PKGNAME[$i]}" ${GRAY}("${PKGVERSION[$i]}")${NC}   "
                else
                    echo -ne "${WHITE}"${PKGNAME[$i]}" ${GRAY}("$LOCALPKGVERSION")${NC}  "
                fi
            elif [ -n "${PKGNAME[$i]}" ]; then 
                echo -ne "${WHITE}"${PKGNAME[$i]}" ${GRAY}("${PKGVERSION[$i]}")${NC}  "
            fi
        }
        echo; echo
        for PACKAGE in ${PKGNAME[@]}; do
            SPACEBUFFER=$(sed -n 's/^REQDSKSPC=//p' $VEILERDBPATH/sync/$PACKAGE/info)
            SPACEBUFFER="$(echo $SPACEBUFFER | sed 's/"//g')"
	        ((TOTALDSR+=SPACEBUFFER))
	        SPACEBUFFER=$(sed -n 's/^DOWNLOADSIZE=//p' $VEILERDBPATH/sync/$PACKAGE/info)
	        SPACEBUFFER="$(echo $SPACEBUFFER | sed 's/"//g')"
	        ((TOTALDOWNLOADSIZE+=SPACEBUFFER))
            SPACEBUFFER=$(sed -n 's/^INSTALLEDSIZE=//p' $VEILERDBPATH/sync/$PACKAGE/info)
	        SPACEBUFFER="$(echo $SPACEBUFFER | sed 's/"//g')"
	        ((TOTALINSTSIZE+=SPACEBUFFER))
	        SPACEBUFFER=$(sed -n 's/^WODOCINSTALLEDSIZE=//p' $VEILERDBPATH/sync/$PACKAGE/info)
            SPACEBUFFER="$(echo $SPACEBUFFER | sed 's/"//g')"
	    ((WODOCINSTSIZE+=SPACEBUFFER))
	    done
        AVAILSPACE=$(df --output=avail | sed -n '2p')
        AVAILSPACE=$((AVAILSPACE*1024))
        if [ $VEILERDOC -eq 1 ]; then
            if [ $AVAILSPACE -le $((TOTALINSTSIZE+TOTALDSR)) ]; then
                echo -e "${RED}ERROR >>>${WHITE} Insufficient disk space!"
                echo -e "${RED}ERROR >>>${WHITE} Required ${YELLOW}> $(((TOTALINSTSIZE+TOTALDSR)/1024/1024)) MiB <${NC} "
                echo -e "${RED}ERROR >>>${WHITE} Available ${YELLOW}> $((AVAILSPACE/1024/1024)) MiB <${NC}"
                exit 1
            fi
        else
            if [ $AVAILSPACE -le $((WODOCTOTALINSTSIZE+TOTALDSR)) ]; then
                echo -e "${RED}ERROR >>>${WHITE} Insufficient disk space!"
                echo -e "${RED}ERROR >>>${WHITE} Required ${YELLOW}> $(((WODOCTOTALINSTSIZE+TOTALDSR)/1024/1024)) MiB <${NC} "
                echo -e "${RED}ERROR >>>${WHITE} Available ${YELLOW}> $((AVAILSPACE/1024/1024)) MiB <${NC}"
                exit 1
            fi
        fi
        if [ $VEILERMBE -eq 1 ]; then
	        ((TOTALDSR=TOTALDSR/1024/1024))
	        echo -e "${DARKBLUE}*** ${BLUE}Total disk space required: ${WHITE}"$TOTALDSR" MiB${NC}"
	        ((TOTALDOWNLOADSIZE=TOTALDOWNLOADSIZE/1024/1024))
            echo -e "${DARKBLUE}*** ${BLUE}Total download size: ${WHITE}"$TOTALDOWNLOADSIZE" MiB${NC}"
	        ((TOTALINSTSIZE=TOTALINSTSIZE/1024/1024))
	        echo -e "${DARKBLUE}*** ${BLUE}Total installed size: ${WHITE}"$TOTALINSTSIZE" MiB${NC}"
	        ((WODOCINSTSIZE=WODOCINSTSIZE/1024/1024))
            echo -e "${DARKBLUE}*** ${BLUE}Total installed size ( without documentation ): ${WHITE}"$WODOCINSTSIZE" MiB${NC}"
	    else
	        ((TOTALDSR/=1024))
            echo -e "${DARKBLUE}*** ${BLUE}Total disk space required: ${WHITE}"$TOTALDSR" KiB${NC}"
            ((TOTALDOWNLOADSIZE/=1024))
	        echo -e "${DARKBLUE}*** ${BLUE}Total download size: ${WHITE}"$TOTALDOWNLOADSIZE" KiB${NC}"
	        ((TOTALINSTSIZE/=1024))
            echo -e "${DARKBLUE}*** ${BLUE}Total installed size: ${WHITE}"$TOTALINSTSIZE" KiB${NC}"
            ((WODOCINSTSIZE/=1024))
