            if [ ! -d Veiler ]; then
                git clone https://github.com/ilovetrees242/Veiler.git
                rm -rf Veiler/*
                pushd Veiler &> /dev/null
                git restore db.tar.gz
                popd &> /dev/null
                rm -rf "$VEILERDBPATH"/sync
            fi
            if [ "$VEILERQUIET" -eq 0 ]; then
                pushd Veiler &> /dev/null
                git pull origin main
                tar -C "$VEILERDBPATH" --strip-components=1 -xvf db.tar.gz
            else
                pushd Veiler &> /dev/null
                git pull origin main &> /dev/null
                tar -C "$VEILERDBPATH" --strip-components=1 -xf db.tar.gz
            fi
