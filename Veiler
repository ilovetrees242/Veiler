            buildPackages
            if [ $VEILERONLYBUILD -eq 1 ]; then
                log_info notice "The package manager has finished building the packages, but has not installed them. Goodluck with whatever you are doing!"
                log_info imp "The build directories can be found at $VEILERCACHEPATH"
            fi
        popd &> /dev/null
	;;
    info)
        PACKAGES=()
        shift
        if [ -z $1 ]; then
            log_err "No package provided!"
        fi
        for((i=1; i <= $#; i++)){
            if [ ! -d "$VEILERDBPATH/local/${!i}" ]; then
                log_warn "${!i} is not installed."
            else
                PACKAGES+=( ${!i} )
            fi
        }
        for((i=0; i < ${#PACKAGES[@]}; i++)){
            if [ -f "$VEILERDBPATH/local/${PACKAGES[$i]}/info" ]; then
                source "$VEILERDBPATH/local/${PACKAGES[$i]}/info" 
                echo -e "${YELLOW}$MOONPKGNAME${NC} ${GRAY}($MOONPKGVERSION)${NC}"
                echo -e "\t${WHITE}$DESC${NC}"
            else
                log_warn "Could not find a valid information file for ${YELLOW}${PACKAGES[$i]}"
            fi
        }
    ;;
	help)
        echo -e "${YELLOW}$0 Usage:${WHITE} $0 <COMMAND> <OPTIONS> ${NC}"
		echo -e "${WHITE}$0 unveil|veil <OPTIONS> [PACKAGE]${NC}"
		echo -e "${WHITE}$0 Options:${NC}" 
        echo -e "${GRAY}--quiet${NC}${WHITE}         : Displays quiet output, not too detailed.${NC}"
	    echo -e "${GRAY}--documentation${NC}${WHITE} : Enables documentation (this might install extra dependencies)${NC}"
        echo -e "${GRAY}--test${NC}${WHITE}          : Enables test harnesses${NC}" 
        echo -e "${GRAY}--ask${NC}${WHITE}           : Use confirmation prompts${NC}"
        echo -e "${GRAY}--no-root${NC}${WHITE}       : Don't use superuser priveledges ( might cause errors when installing in priveleged directories )${NC}"
        echo -e "${GRAY}--skip-clean${NC}${WHITE}    : Skip deleting existing build directories in cache ( will cause the package manager to not start building from scratch${NC}"
        echo -e "${GRAY}--skip-deps${NC}${WHITE}     : Skip dependency check ( can break packages )${NC}"
        echo -e "${GRAY}--megabytes${NC}${WHITE}     : Show size in megabytes instead of kilobytes${NC}"
        echo -e "${GRAY}--skip-integrity${NC}${WHITE}: Do not verify package integrity ( unsafe and can lead to security issues and building corrupted packages )${NC}"
        echo -e "${GRAY}--no-errexit${NC}${WHITE}    : Do not exit upon an error WHILE building the packages ( might cause you to have broken packages installed lol )${NC}"
		echo -e "${WHITE}unveil     : Installs a package from source.${NC}"
