        resolvedeps ${UPGRADEDPACKAGES[@]}
        echo -en "${WHITE}\nPackages to be upgraded ${GRAY}(${#UPRGADEDPACKAGES[@]}): "
        for((i=0; i < ${#UPGRADEDPACKAGES[@]}; i++)){
