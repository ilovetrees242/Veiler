#!/bin/bash
# Main package manager related variables
declare -a OPTIONS PACKAGES
PKGREPO="https://ilovetrees242.github.io/DevHelp/Website/Packages"
# Soon there will be a feature to use multiple features. altrough not yet
VEILERTESTS=0
VEILERQUIET=0
VEILERDOC=0
VEILERASK=0
VEILERSKIPDESC=0
VEILERONLYBUILD=0
VEILERNOROOT=0
VEILERSKIPDEPS=0
VEILERSKIPCLEAN=0
VEILERSKIPINST=0
VEILERDEST="/"
VEILERCACHEPATH="/var/cache/Veiler/"
VEILERDBPATH="/var/db/Veiler"
PROCESSID=""

# Colors
DARKBLUE='\033[0;34m'
BLUE='\033[1;34m'
RED='\033[1;31m'
YELLOW='\033[1;33m'
ORANGE='\033[0;33m'
WHITE='\033[1;37m'
GRAY='\033[0;37m'
DARKGRAY='\033[1;30m'
NC='\033[0m'

# Package handling related variables
declare -a PKGNAME PKGVERSION
PACKAGES=""
PACKAGEBUFFER=""
VICTIMPACKAGES=""
DEPSBUFFER=""
DEPS=""
VICTCNTR=0
DEPCNTR=0
DEPBUFCNTR=0

# Space and size related variables
TOTALDSR=0
TOTALINSTSIZE=0
TOTALDOWNLOADSIZE=0
WODOCINSTSIZE=0

. /etc/veiler.conf 
trap 'veiler_stop_animation' TERM 
trap 'echo -e "\n${YELLOW}Interrupted${NC}"; veiler_stop_animation; ' INT

# --- Functions ---
play_animation(){
    while true; do
        printf "\r$1${WHITE}   ${NC}"; sleep 0.1
        printf "\r$1${WHITE}.  ${NC}"; sleep 0.1
        printf "\r$1${WHITE}.. ${NC}"; sleep 0.1
        printf "\r$1${WHITE}...${NC}"; sleep 0.1
    done &
    PROCESSID=$!
}
second_animation(){
    while true; do
        printf "\r$1${WHITE} [/]${NC}"; sleep 0.2
        printf "\r$1${WHITE} [-]${NC}"; sleep 0.2
        printf "\r$1${WHITE} [\\]${NC}"; sleep 0.2
        printf "\r$1${WHITE} [-]${NC}"; sleep 0.2
    done &
    PROCESSID=$!
}
veiler_stop_animation(){
    if [ -n "$PROCESSID" ]; then kill "$PROCESSID" &> /dev/null; echo; fi
}
clean(){
    if [ $VEILERSKIPCLEAN -eq 0 ]; then
        for directory in $(find  -type d | sed '1d'); do
            rm -rf "${directory}"
        done        
    else
        return
    fi
}
log_warn(){
    echo -e "${ORANGE}WARNING >>>${WHITE} $1${NC}"
}
log_err(){
    echo -e "${RED}ERROR >>>${WHITE} $1${NC}"
    exit 1 
}
log_info(){
    case $1 in
        tip)
            echo -e "${BLUE}Tip >>>${WHITE} $2${NC}"
        ;;
        imp)
            echo -e "${YELLOW}Important >>>${WHITE} $2${NC}"    
        ;;
        notice)
            echo -e "${YELLOW}Notice >>>${WHITE} $2${NC}"    
        ;;
        activity)
            echo -e "${YELLOW}Activity >>>${WHITE} $2${NC}"    
        ;;
    esac
}
checkifroot(){
    if [ $VEILERNOROOT -eq 0 -a $(id -u) -ne 0 ]; then
        log_err "You have to become root to perform this action."
    fi
}
checkIfAlreadyInstalled(){
    declare -a local newPackages
    newPackages=()
    for PACKAGE in $@; do
        if [ ! -d "$VEILERDBPATH/local/$PACKAGE" ]; then
            newPackages+=( $PACKAGE )
        fi
    done
    echo ${newPackages[@]}
}
getBuildTarballs(){
    log_info imp "Fetching package(s)..."
    for((i=0; i < ${#PKGNAME[@]}; i++)){
        if [ ! -f "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}".tar.gz" ]; then
            if [ $VEILERQUIET -eq 0 ]; then
                wget -nv --show-progress "$PKGREPO/build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}".tar.gz"
            else
                wget -q --show-progress "$PKGREPO/build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}".tar.gz"
            fi
            if [ $? -ne 0 ]; then
                log_err "Could not download the package ${YELLOW}${PKGNAME[$i]}${WHITE}!"
                log_info tip "Maybe try running $0 ${GRAY}sync?${NC}"
            fi
        fi
    }
}
extractBuildTarballs(){
    log_info imp "Extracting the package build tarball(s)..."
    for((i=0; i < ${#PKGNAME[@]}; i++)){
        echo -e "${GRAY}($((i+1))/${#PKGNAME[@]}) ${WHITE}Extracting ${YELLOW}>>> ${WHITE}${PKGNAME[$i]}"
        if [ $VEILERQUIET -eq 1 ]; then
            tar xf "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}".tar.gz"
        else
            tar xvf "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}".tar.gz"
        fi
        if [ $? -ne 0 ]; then
            log_err "${GRAY}($((i+1))/${#PKGNAME[@]})${WHITE} Could not extract the build tarball for ${RED}>>> ${WHITE}${PKGNAME[$i]}"
        fi
    }
}
getSources(){
    log_info imp "Getting source(s)..."
    for((i=0; i < ${#PKGNAME[@]}; i++)){
        pushd "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}"" &> /dev/null
            source ./MOONBUILD getpkg
            if [ $? -ne 0 ]; then
                log_err "${GRAY}($((i+1))/${#PKGNAME[@]})${WHITE} Failed to download the source for ${PKGNAME[$i]}"
            fi
        popd &> /dev/null
    }
}
verifyChecksums(){
    for((i=0; i < ${#PKGNAME[@]}; i++)){
        echo -ne "\r${YELLOW}Important >>> ${GRAY}("$((i+1))"/"${#PKGNAME[@]}") ${WHITE}Verifying package integrity ${DARKBLUE}|||${WHITE} ${PKGNAME[$i]}                                     ${NC}"
        pushd "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}"" &> /dev/null
            # Package integrity verification is still not finalised. Later there will be a proper implementation
            sha256sum -c --quiet integrity.sha256
            if [ $? -ne 0 ]; then
                echo
                log_err "${GRAY}($((i+1))/${#PKGNAME[@]})${WHITE} Failed to verify package integrity for package ${RED}>>>${WHITE} ${PKGNAME[$i]}"
            fi
        popd &> /dev/null
        tar -cf "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}".tar.gz" "build-"${PKGNAME[$i]}"-"${PKGVERSION[$i]}"" 
        sleep 0.1
    }; echo
}
buildPackages(){
    export MAKEFLAGS
    log_info imp "Building the package(s)..."
    if [ $VEILERONLYBUILD -eq 0 ]; then export DESTDIR; fi
    for((i=0; i < ${#PKGNAME[@]}; i++)){
        echo -e "${GRAY}($((i+1))/${#PKGNAME[@]})${WHITE} Building ${BLUE}>>> ${WHITE}${PKGNAME[$i]}${NC}"
        pushd "build-${PKGNAME[$i]}-${PKGVERSION[$i]}" &> /dev/null
            source ./MOONBUILD build
            if [ $? -ne 0 ]; then
                log_err "${GRAY}($((i+1))/${#PKGNAME[@]})${WHITE} Failed to build the package ${RED}>>> ${WHITE}${PKGNAME[$i]}"
            fi
            if [ $VEILERONLYBUILD -eq 0 ]; then 
                echo -e "${GRAY}($((i+1))/${#PKGNAME[@]})${WHITE} Installing ${YELLOW}>>> ${WHITE}${PKGNAME[$i]}${NC}"
                DESTDIR=$VEILERDEST source ./MOONBUILD install
                if [ $? -ne 0 ]; then
                    log_err "${GRAY}($((i+1))/${#PKGNAME[@]})${WHITE} Failed to install the package ${RED}>>> ${WHITE}${PKGNAME[$i]}"
                fi
                cp -r $VEILERDBPATH/sync/${PKGNAME[$i]} $VEILERDBPATH/local
            fi
        popd &> /dev/null
        echo -e "${GRAY}($((i+1))/${#PKGNAME[@]}) ${WHITE}Completed the build${DARBKLUE} >>> ${WHITE}${PKGNAME[$i]}${NC}"
    }
}
uninstallPackages(){
    log_info imp "Uninstalling the package(s)"
    for((i=0; i < ${#PKGNAME[@]}; i++)){
        echo -e "${GRAY}($((i+1))/${#PKGNAME[@]}) ${WHITE}Uninstalling ${BLUE}>>> ${WHITE}${PKGNAME[$i]}${NC}"
        pushd "build-${PKGNAME[$i]}-${PKGVERSION[$i]}" &> /dev/null
        source ./MOONBUILD uninstall
        if [ $? -ne 0 ]; then
            log_err "${GRAY}($((i+1))/${#PKGNAME[@]})${WHITE} Failed to uninstall ${RED}>>>${WHITE} ${PKGNAME[$i]}"
        fi
        popd &> /dev/null
        echo -e "${GRAY}($((i+1))/${#PKGNAME[@]}) ${WHITE}Successfully uninstalled ${DARKBLUE}>>> ${WHITE}${PKGNAME[$i]}${NC}"
    }
}
makepkgarray(){
    PKGVERSION=()
    PKGNAME=()
    while [ $# -gt 0 ]; do
        local BUFFERPKGVERSION="$(sed -n 's/^MOONPKGVERSION=//; s/"$//; s/^"//p' $VEILERDBPATH/sync/$1/info)"
        local BUFFERPKGNAME="$(sed -n 's/^MOONPKGNAME=//; s/"$//; s/^"//p' $VEILERDBPATH/sync/$1/info)"
        if [ -z "$BUFFERPKGVERSION" -a -z "$BUFFERPKGNAME" ]; then
            log_warn "No valid information related to ${YELLOW}$1${WHITE} could be found. Skipping this package..."
            shift
            continue
        elif [ -z "$BUFFERPKGVERSION" ]; then
            log_warn "No valid version could be found for ${YELLOW}$1${WHITE}. Skipping this package..." 
            shift
            continue
        elif [ -z "$BUFFERPKGNAME" ]; then
            log_warn "No valid name could be found for ${YELLOW}$1${WHITE}. Skipping this package..."
            shift
            continue
        fi
        PKGVERSION+=( "$BUFFERPKGVERSION" )
        PKGNAME+=( "$BUFFERPKGNAME" )
        shift
    done
}
# --- End Functions ---
while [ $# -gt 0 ]; do
    case $1 in 
        --*)
            OPTIONS+=($1)
            case $1 in
                --with-dest)
                    if [ -n $2 ]; then
                        OPTIONS+=($2); shift
                    else
                        log_err "The option ${GRAY}--with-dest${NC} requires an argument!"
                    fi
            esac
        ;;
        *)
            ARGUMENTS+=($1)
        ;;
    esac
    shift
done
for((i=0; i < ${#OPTIONS[@]}; i++)){
    case ${OPTIONS[$i]} in
        --quiet)
            if [ $VEILERQUIET -eq 0 ]; then VEILERQUIET=1; else log_err "Quiet mode already enabled!"; fi
        ;;
        --documentation)
            if [ $VEILERDOC -eq 0 ]; then VEILERDOC=1; else log_err "Documentation already enabled!"; fi
        ;;
        --tests)
            if [ $VEILERTESTS -eq 0 ]; then VEILERTESTS=1; else log_err "Tests already enabled!"; fi
        ;;
        --ask)
            if [ $VEILERASK -eq 0 ]; then VEILERASK=1; else log_err "Confirmation prompts already enabled!"; fi
        ;;
        --skip-description)
            if [ $VEILERSKIPDESC -eq 0 ]; then VEILERSKIPDESC=1; else log_err "Description skipping already enabled!"; fi
        ;;
        --build-only)
            if [ $VEILERONLYBUILD -eq 0 ]; then VEILERONLYBUILD=1; else log_err "Build only mode already enabled!"; fi
        ;;
        --no-root)
            if [ $VEILERNOROOT -eq 0 ]; then VEILERNOROOT=1; else log_err "No root alreay enabled!"; fi
        ;;
        --with-dest)
            VEILERDEST=${OPTIONS[$((i+1))]}; ((i++))
        ;;            
        --skip-deps)
            if [ $VEILERSKIPDEPS -eq 0 ]; then VEILERSKIPDEPS=1; else log_err "Skipping dependencies already enabled!"; fi
        ;;
        --skip-clean)
            if [ $VEILERSKIPCLEAN -eq 0 ]; then VEILERSKIPCLEAN=1; else log_err "Skipping cleaning already enabled!"; fi
        ;;
        --skip-installed)
            if [ $VEILERSKIPINST -eq 0 ]; then VEILERSKIPINST=1; else log_err "Skipping installed packages already enabled!"; fi
        ;;
        *)
            log_err "Invalid option ${GRAY}${OPTIONS[$i]}${NC}"
        ;;
    esac    
}
if [ $VEILERSKIPINST -eq 1 ]; then
    set -- $(checkIfAlreadyInstalled ${ARGUMENTS[@]})
else
    set -- ${ARGUMENTS[@]}
fi
if [ $(echo $VEILERCACHEPATH | cut -c1) != "/" ]; then
    log_err "Cache path must be absolute."
elif [ $(echo $VEILERDBPATH | cut -c1) != "/" ]; then
    log_err "DB path must be absolute."
fi
case $1 in
	unveil)
        shift
        if [ -z "$1" ]; then
            log_err "Nothing to install."
        fi
        checkifroot
        BUFFER=$(echo $VEILERDEST | cut -c1 )
        if [ $BUFFER != "/" ]; then
            log_warn "It is highly advised to use absolute paths instead of relative paths for installation of packages. If possible, please try to use absolute paths as much as you can. You can use \$PWD/<DESTDIR> to get an absolute path instead of a relative path. Using relative paths will most likely lead to breakages, for which I am not responsible."
            log_info imp "Proceeding to install in: "
            for i in 1 2 3 4 5; do
                echo -ne "$i... "
                sleep 2
            done
            echo -e "${NC}"
        fi
        if [ $VEILERONLYBUILD -eq 0 ]; then
            log_info notice "Packages will be installed in $VEILERDEST"
        fi
        play_animation "$(log_info activity "Checking if packages exist")"
        sleep 0.1
        for PACKAGE in "$@"; do
            if [ ! -d "$VEILERDBPATH/sync/$PACKAGE" ]; then veiler_stop_animation ; log_err "The requested package ${YELLOW}$PACKAGE${WHITE} could not be found on the database"; fi
        done
        veiler_stop_animation
        makepkgarray $@
        if [ $VEILERSKIPDEPS -eq 0 ]; then
            second_animation "$(log_info imp "Calculating dependencies")"
            PKGCOUNT=0 
            for PACKAGE in "$@"; do
                PACKAGES[$PKGCOUNT]=$PACKAGE
                ((PKGCOUNT++))
            done
            for((i=0; i < ${#PACKAGES[@]}; i++)){
                PACKAGEBUFFER[$i]=${PACKAGES[$i]}
            } 
            # PACKAGES contains the packages which actually need to installed
            # PACKAGEBUFFER contains the packages whos depdencies are being checked
            # DEPS contains the all the found dependencies of all packages generated by the graph
            # DEPSBUFFER contains the packages whos dependencies will be checked after the next iteration
            # VICTIMPACKAGES holds a single copy of every package
        
            # Example -> which neofetch, missing deps: bash, ncurses, readline
            # Contents of PACKAGEBUFFER->
            # Stage 1 : which neofetch
            # stage 2 : bash bash
            # Stage 3 : ncurses readline ncurses readline
            # Stage 4 : 
            while [ ! -z "$PACKAGEBUFFER" ]; do
                for PACKAGE in ${PACKAGEBUFFER[@]}; do 
                    while read DEPENDENCY; do
                        if [ ! -d "$VEILERDBPATH/local/$DEPENDENCY" ]; then 
                            DEPS[$DEPCNTR]=$DEPENDENCY
                            DEPSBUFFER[$DEPBUFCNTR]=$DEPENDENCY
                            ((DEPCNTR++))
                            ((DEPBUFCNTR++))
                        fi
                done < "$VEILERDBPATH/sync/$PACKAGE/dependencies"
            done
            PACKAGEBUFFER=()
            for((i=0; i < ${#DEPSBUFFER[@]}; i++)){
                PACKAGEBUFFER[$i]=${DEPSBUFFER[$i]}
            }
            DEPSBUFFER=()
            DEPBUFCNTR=0
            done    
            checkifexists(){
                for((i=0; i < ${#VICTIMPACKAGES[@]}; i++)){
                    if [ "${VICTIMPACKAGES[$i]}" == "$1" ]; then
                        echo "yes"; return 0;
                    fi
                }
                echo "no"
            }
            for((i=0; i < ${#PACKAGES[@]}; i++)){
                PACKAGEBUFFER[$i]=${PACKAGES[$i]}
            }
            for((i=0; i < ${#DEPS[@]}; i++)){
                PACKAGEBUFFER[${#PACKAGEBUFFER[@]}]=${DEPS[$i]}
            }
            for((i=0; i < ${#PACKAGEBUFFER[@]}; i++)){
                EXISTS=$(checkifexists ${PACKAGEBUFFER[$i]})
                if [ $EXISTS == "no" ]; then
                    VICTIMPACKAGES[$VICTCNTR]=${PACKAGEBUFFER[$i]}
                    ((VICTCNTR++))
                fi
            }
            BUFFER=${PACKAGEBUFFER[@]}
            for PACKAGE in ${VICTIMPACKAGES[@]}; do
                OCCURENCES=$(echo ${PACKAGEBUFFER[@]} | grep -ow "$PACKAGE" | wc -w)
                ((OCCURENCES--))
                for((i=0; i < $OCCURENCES; i++)){
                    BUFFER=$(echo $BUFFER | sed "s@$PACKAGE@@1")
                }
            done
            # Reverse the packages to build in correct order
            PACKAGES=( $BUFFER )
            PACKAGES=( $(printf "%s\n" ${PACKAGES[@]} | tac) )
            set -- ${PACKAGES[@]}
            veiler_stop_animation
        fi
        echo -ne "\n${YELLOW}Packages to be installed: ${NC}"
        for((i=0; i < $#; i++)){
            if [ -d $VEILERDBPATH/local/"${PKGNAME[$i]}" -a -n "${PKGNAME[$i]}" ]; then
                LOCALPKGVERSION="$(sed -n 's/^MOONPKGVERSION=//; s/"$//; s/^"//p' $VEILERDBPATH/local/"${PKGNAME[$i]}"/info)"
                if [ "${PKGVERSION[$i]}" != "$LOCALPKGVERSION" ]; then
                    echo -ne "${WHITE}"${PKGNAME[$i]}" ${GRAY}("$LOCALPKGVERSION")${WHITE} -> "${PKGNAME[$i]}" ${GRAY}("${PKGVERSION[$i]}")${NC}   "
                else
                    echo -ne "${WHITE}"${PKGNAME[$i]}" ${GRAY}("$LOCALPKGVERSION")${NC}  "
                fi
            elif [ -n "${PKGNAME[$i]}" ]; then 
                echo -ne "${WHITE}"${PKGNAME[$i]}" ${GRAY}("${PKGVERSION[$i]}")${NC}  "
            fi
        }
        echo; echo
        for PACKAGE in $@; do
            SPACEBUFFER=$(sed -n 's/^REQDSKSPC=//p' $VEILERDBPATH/sync/$PACKAGE/info)
            SPACEBUFFER="$(echo $SPACEBUFFER | sed 's/"//g')"
            ((TOTALDSR+=SPACEBUFFER))
        done
        ((TOTALDSR/=1024))
        echo -e "${DARKBLUE}*** ${BLUE}Total disk space required: ${WHITE}"$TOTALDSR"KiB${NC}"
        for PACKAGE in $@; do
            SPACEBUFFER=$(sed -n 's/^DOWNLOADSIZE=//p' $VEILERDBPATH/sync/$PACKAGE/info)
            SPACEBUFFER="$(echo $SPACEBUFFER | sed 's/"//g')"
            ((TOTALDOWNLOADSIZE+=SPACEBUFFER))
        done
        ((TOTALDOWNLOADSIZE/=1024))
        echo -e "${DARKBLUE}*** ${BLUE}Total download size: ${WHITE}"$TOTALDOWNLOADSIZE"KiB${NC}"
        for PACKAGE in $@; do
            SPACEBUFFER=$(sed -n 's/^INSTALLEDSIZE=//p' $VEILERDBPATH/sync/$PACKAGE/info)
            SPACEBUFFER="$(echo $SPACEBUFFER | sed 's/"//g')"
            ((TOTALINSTSIZE+=SPACEBUFFER))
        done
        ((TOTALINSTSIZE/=1024))
        echo -e "${DARKBLUE}*** ${BLUE}Total installed size: ${WHITE}"$TOTALINSTSIZE"KiB${NC}"
        for PACKAGE in $@; do
            SPACEBUFFER=$(sed -n 's/^WODOCINSTALLEDSIZE=//p' $VEILERDBPATH/sync/$PACKAGE/info)
            SPACEBUFFER="$(echo $SPACEBUFFER | sed 's/"//g')"
            ((WODOCINSTSIZE+=SPACEBUFFER))
        done
        ((WODOCINSTSIZE/=1024))
        echo -e "${DARKBLUE}*** ${BLUE}Total installed size ( without documentation ): ${WHITE}"$WODOCINSTSIZE"KiB${NC}"
        if [ "$VEILERASK" -eq 1 ]; then
            echo -ne "\n${YELLOW}||| ${WHITE}Proceed with the installation?[y/n]: "
            read -n 1
            if [ "$REPLY" == "y" ]; then
                echo; true
            else
                echo -e "\n${WHITE}Goodbye!${NC}"; exit 0
            fi
        fi
        clean
        log_info notice "Changing directory to $VEILERCACHEPATH..."
        pushd $VEILERCACHEPATH &> /dev/null 
        getBuildTarballs 
        extractBuildTarballs 
        getSources 
        verifyChecksums 
        buildPackages
        if [ $VEILERONLYBUILD -eq 1 ]; then
            log_info notice "The package manager has finished building the packages, but has not installed them. Goodluck with whatever you are doing!"
            log_info imp "The build directories can be found at $VEILERCACHEPATH"
        fi
        popd &> /dev/null
    ;;
	veil)
        shift
        if [ -z "$1" ]; then
            log_err "No package was provided!"
        fi
        checkifroot
        play_animation "$(log_info activity "Checking if packages exist")"
        for PACKAGE in "$@"; do
            if [ ! -d "$VEILERDBPATH/sync/$PACKAGE" ]; then veiler_stop_animation; log_err "The requested package ${YELLOW}$PACKAGE${WHITE} could not be found on the database.${NC}"; fi
        done
        sleep 0.1
        veiler_stop_animation
        makepkgarray $@
        echo -ne "\n${YELLOW}Packages to be uninstalled: ${WHITE}"
        for((i=0; i < ${#PKGNAME[@]}; i++)){
            echo -ne "${WHITE}${PKGNAME[$i]} ${GRAY}(${PKGVERSION[$i]})${NC}   "
        }
        if [ $VEILERASK -eq 1 ]; then
            echo -ne "\n\n${BLUE}||| ${WHITE}Proceed with the uninstallation?[y/n]: ${NC}"
            read -n 1
            if [ $REPLY == "y" ]; then
                true; echo
            else
                echo -e "\n${WHITE}Goodbye!${NC}"; exit 0
            fi
        else 
            echo -e "\n"
        fi
        log_info notice "Changing directory to $VEILERCACHEPATH..."
        pushd $VEILERCACHEPATH &> /dev/null && clean &> /dev/null
        getBuildTarballs
        extractBuildTarballs
        getSources 
        verifyChecksums 
        uninstallPackages
        popd &> /dev/null
	;;
	strengthen)
        # TO DO: Later, add a feature to update packages installed on system if new version has been released and is greater than installed version
        bruh
	;;
    info)
        shift
        if [ -z $1 ]; then
            echo -e "${YELLOW}No package provided.${NC}"
        fi
        for((i=1; i <= $#; i++)){
            if [ ! -d "$VEILERDBPATH/local/${!i}" ]; then
                echo -e log_warn "${!i} is not installed."
                set -- $(echo "$@" | sed "s@${!i}@@")
                i=1
            fi
        }
        for((i=1; i <= $#; i++)){
            source "$VEILERDBPATH/local/${!i}/info" 2&> /dev/null
            echo -e "${YELLOW}$MOONPKGNAME${NC} ${GRAY}($MOONPKGVERSION)${NC}"
            echo -e "\t${WHITE}$DESC${NC}"
        }
    ;;
	help)
        echo -e "${YELLOW}$0 Usage:${WHITE} $0 <COMMAND> <OPTIONS> ${NC}"
		echo -e "${WHITE}$0 unveil|veil <OPTIONS> [PACKAGE]${NC}"
		echo -e "${WHITE}$0 Options:${NC}" 
	    echo -e "${GRAY}--verbose${NC}${WHITE}       : Displays verbose output${NC}"
        echo -e "${GRAY}--quiet${NC}${WHITE}         : Displays quiet output, not too detailed.${NC}"
	    echo -e "${GRAY}--documentation${NC}${WHITE} : Enables documentation (this might install extra dependencies)${NC}"
        echo -e "${GRAY}--test${NC}${WHITE}          : Enables test harnesses${NC}" 
        echo -e "${GRAY}--ask${NC}${WHITE}           : Use confirmation prompts${NC}"
        echo -e "${GRAY}--no-root${NC}${WHITE}       : Don't use superuser priveleges ( might cause errors when installing in priveleged directories )${NC}"
        echo -e "${GRAY}--skip-clean${NC}${WHITE}    : Skip deleting existing build directories in cache${NC}"
        echo -e "${GRAY}--skip-clean${NC}${WHITE}    : Skip dependency check ( can break packages )${NC}"
		echo -e "${WHITE}unveil     : Installs a package from source.${NC}"
        echo -e "${WHITE}   -> ${GRAY}--with-dest <DESTDIR> ${WHITE}: Installs package into <DESTDIR> instead of default /${NC}"
        echo -e "${WHITE}   -> ${GRAY}--build-only          ${WHITE}: This option makes the package manager only compile and build the package and skip installing it.${NC}"
		echo -e "${WHITE}veil       : Uninstalls a package installed on the system${NC}"
		echo -e "${WHITE}strengthen : Updates all packages installed on the system${NC}"
		echo -e "${WHITE}search     : Matches regex with a package name in the package database${NC}"
        echo -e "${WHITE}   -> ${GRAY}--skip-description: ${WHITE}To avoid matching the regex with found descriptions${NC}"
		echo -e "${WHITE}help       : Displays this output${NC}"
        echo -e "${WHITE}version    : Display package manager version${NC}"
        echo -e "${WHITE}info       : Display information about installed packages${NC}"
        echo -e "${WHITE}rmpkg      : Removes ALL the tarballs of the specified package in the cache ( useful for reducing disk space usage and making the package manager download the package build tarball again, which may be done if the maintainer has applied some patches to the build script )${NC}"
        echo -e "${YELLOW}Note: ${WHITE}See https://ilovetrees242.github.io/DevHelp/Website/Veiler.html for detailed information${NC}"
	;;
    version)
            echo -e "${WHITE}I like the ${YELLOW}moon${WHITE}, so this package manager is based of it."
            echo "__    __  _____   o  ___    _____   _____  "
            echo "\ \  / / |     | | | | |   |     |  | ___\ " 
            echo " \ \/ /  | ----| | | | |_  | ----|  | |    "
            echo "  \__/   |_____  |_| |___| |_____   |_|    "
            echo -e "${NC}"
            echo -e "${YELLOW}Veiler ${WHITE}development version 1.3.2${NC}"
    ;;
    search)
        shift
        FOUNDPACKAGES=""
        FOUNDPACKAGESVERSION=""
        FOUNDPACKAGESDESC=""
        FOUNDPACKAGESINSTALLED=""
        if [ -z $1 ]; then
            log_err "No package was provided!"
        fi
        if [ $VEILERSKIPDESC -eq 1 ]; then
            COUNT=0
            for((i=1; i <= $#; i++)){
                PACKAGES=$(ls -d $VEILERDBPATH/sync/*${!i}*  /dev/null)
                for PACKAGE in $PACKAGES; do
                    if [ -f $PACKAGE/info ]; then
                        source $PACKAGE/info 
                        FOUNDPACKAGES[$COUNT]="$MOONPKGNAME"
                        FOUNDPACKAGESVERSION[$COUNT]="$MOONPKGVERSION"
                        FOUNDPACKAGESDESC[$COUNT]="$DESC"
                        if [ -n ${FOUNDPACKAGES[$COUNT]} ]; then
                            if [ -d "$VEILERDBPATH/local/${FOUNDPACKAGES[$COUNT]}" ]; then
                                FOUNDPACKAGESINSTALLED[$COUNT]=" ${WHITE}||| ${YELLOW}Installed : ${WHITE}Yes${NC}"
                            else
                                FOUNDPACKAGESINSTALLED[$COUNT]=" ${WHITE}||| ${YELLOW}Installed : ${WHITE}No${NC}"
                            fi  
                            ((COUNT++))
                        fi
                    fi
                done
            }   
            for((i=0; i < ${#FOUNDPACKAGES[@]} - 1; i++)){
                echo -ne "${WHITE}${FOUNDPACKAGES[$i]}${NC}"
                echo -ne "${GRAY}(${FOUNDPACKAGESVERSION[$i]})${NC}"
                echo -e "${FOUNDPACKAGESINSTALLED[$i]}"
                echo -e "\t${WHITE}${FOUNDPACKAGESDESC[$i]}${NC}"
            } | more
        else
            COUNT=0
            for((i=1; i <= $#; i++)){
                PACKAGES=$(ls $VEILERDBPATH/sync/)
                for PACKAGE in $PACKAGES; do
                    if [ -f $VEILERDBPATH/sync/$PACKAGE/info ]; then 
                        source $VEILERDBPATH/sync/$PACKAGE/info 
                        FOUNDPACKAGES[$COUNT]=$(echo $MOONPKGNAME | grep "${!i}")
                        FOUNDPACKAGESDESC[$COUNT]=$(echo $DESC | grep "${!i}")
                        if [[ -n "${FOUNDPACKAGES[$COUNT]}" || -n "${FOUNDPACKAGESDESC[$COUNT]}" ]]; then
                            FOUNDPACKAGES[$COUNT]="$MOONPKGNAME"
                            FOUNDPACKAGESVERSION[$COUNT]="$MOONPKGVERSION"
                            FOUNDPACKAGESDESC[$COUNT]="$DESC"
                            if [ -d "$VEILERDBPATH/local/${FOUNDPACKAGES[$COUNT]}" ]; then
                                FOUNDPACKAGESINSTALLED[$COUNT]=" ${WHITE}||| ${YELLOW}Installed : ${WHITE}Yes${NC}"
                            else
                                FOUNDPACKAGESINSTALLED[$COUNT]=" ${WHITE}||| ${YELLOW}Installed : ${WHITE}No${NC}"
                            fi  
                            ((COUNT++))
                            unset MOONPKGNAME MOONPKGVERSION DESC
                        fi
                    fi
                done
            }
            for((i=0; i < ${#FOUNDPACKAGES[@]} - 1; i++)){
                echo -ne "${WHITE}${FOUNDPACKAGES[$i]} ${NC}"
                echo -ne "${GRAY}(${FOUNDPACKAGESVERSION[$i]})${NC}"
                echo -e "${FOUNDPACKAGESINSTALLED[$i]}"
                echo -e "\t${WHITE}${FOUNDPACKAGESDESC[$i]}${NC}"
            } | more
        fi
    ;;
    sync)
        log_info imp "${YELLOW}||${WHITE} Syncing package repo"
        if [ -d /usr/lib/Veiler ]; then
            pushd /usr/lib/Veiler &> /dev/null
            trap 'log_err "Could not sync repo!"' ERR
            set -e
            if [ ! -d Veiler ]; then
                git clone https://github.com/ilovetrees242/Veiler.git
                rm -rf Veiler/*
                pushd Veiler &> /dev/null
                git restore db.tar.gz
                popd &> /dev/null
            fi
            if [ "$VEILERQUIET" -eq 0 ]; then
                pushd Veiler &> /dev/null
                git pull origin main
                tar -C $VEILERDBPATH --strip-components=1 -xvf db.tar.gz
            else
                pushd Veiler &> /dev/null
                git pull origin main &> /dev/null
                tar -C $VEILERDBPATH --strip-components=1 -xf db.tar.gz
            fi
            set +e
            trap - ERR
            popd &> /dev/null
        else
            log_err "The package manager is not installed. Run the installation script again"
        fi
    ;;
    rmpkg)
        shift
        checkifroot
        if [ -z "$1" ]; then
            log_err "No package was provided!"
        fi
        PACKAGES=()
        for((i=1; i <= $#; i++)){
            PACKAGES[$((i-1))]=$(find $VEILERCACHEPATH -name "build-"${!i}"-*.*")
        }
        if [ -z "${PACKAGES[@]}" ]; then
            log_err "No occurences of the following packages could be found"
        fi
        log_info notice "The following occurences were found: "
        echo ${PACKAGES[@]}
        if [ $VEILERASK -eq 1 ]; then
            echo -ne "${WHITE}Are you sure you would like to ${RED}delete${WHITE} them?[y/n]: ${NC}"
            read -n 1
            if [ "$REPLY" == "y" ]; then
                true; echo
            elif [ "$REPLY" == "n" ]; then
                echo; exit 0
            fi
        fi
        trap 'log_err "Could not delete one or more occurences"' ERR
        for((i=0; i < ${#PACKAGES[@]}; i++)){
            if [ $VEILERQUIET -eq 1 ]; then
                rm -rf "${PACKAGES[$i]}"
            else
                rm -rfv "${PACKAGES[$i]}"
            fi
        }
        log_info notice "Successfully deleted all the occurences for: $@"
    ;;
	*)
        if [ -z $1 ]; then 
            log_err "No action specified!"
        else
            log_err "Invalid action ${RED}$1${WHITE} specified!"
        fi
        $0 help
	;;
esac
