        }; echo
        echo -en "${WHITE}\nNew additional dependencies to be installed: ${NC}"
        if [ ${#ADDITIONALDEPS[@]} -ne 0 ]; then
            for PACKAGE in ${ADDITIONALDEPS[@]}; do
                if [ -f $VEILERDBPATH/sync/$PACKAGE/info ]; then
                    source $VEILERDBPATH/sync/$PACKAGE/info
                    printf "${WHITE}${MOONPKGNAME} ${GRAY}(${MOONPKGVERSION})   "
