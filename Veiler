            echo -e "${RED}ERROR >>>${WHITE} Insufficient disk space!"
            echo -e "${RED}ERROR >>>${WHITE} Required ${YELLOW}> $((TOTALUPGRADESIZEWODOC/1024/1024)) MiB <${NC} "
            echo -e "${RED}ERROR >>>${WHITE} Available ${YELLOW}> $((AVAILSPACE/1024/1024)) MiB <${NC}"
            exit 1
        fi
        echo -e "${DARKBLUE}***${BLUE} Total upgrade size:${WHITE} $TOTALUPGRADESIZE${NC}"
        echo -e "${DARKBLUE}***${BLUE} Total upgrade size ( without documentation ):${WHITE} $TOTALUPGRADESIZEWODOC${NC}"
        if [ $VEILERASK -eq 1 ]; then
            echo -ne "\n${BLUE}||| ${WHITE}Proceed with the upgrade?[y/n]: ${NC}"
            read -n 1
            if [ $REPLY == "y" -o $REPLY == "Y" -o $REPLY == "yes" ]; then
                true; echo 
            else
               echo -e "\n${BLUE}Goodbye!${NC}"; exit 0
